---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 200 36"
  class={`h-[32px] sm:h-[36px] w-auto overflow-visible select-none ${className}`}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Astro by Anisha — Vedic Astrology & Contemplative Tarot"
>
  <!-- Main Brand Title -->
  <text
    x="0"
    y="19"
    font-family="'Cormorant Garamond', Georgia, serif"
    font-size="22"
    font-weight="600"
    letter-spacing="-0.01em"
    class="fill-[#1c1917] dark:fill-[#f5f5f7] transition-colors duration-200 group-hover:fill-[#a37a4c]"
  >Astro by Anisha</text>

  <!-- Practices Subtitle (tightly locked below title baseline) -->
  <text
    x="0.5"
    y="31"
    font-family="'Plus Jakarta Sans', system-ui, -apple-system, sans-serif"
    font-size="7.5"
    font-weight="600"
    letter-spacing="0.22em"
    class="fill-[#857f77] dark:fill-[#8b8b94]"
  >VEDIC ASTROLOGY • TAROT</text>
</svg>
