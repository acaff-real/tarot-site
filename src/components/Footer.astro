---
import GlassButton from './GlassButton.astro';

const YEAR = new Date().getFullYear();
---

<footer class="border-t border-[#28231e]/10 bg-[#f7f4ed] text-[#1c1917] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 pb-14 border-b border-[#28231e]/10">
      
      <!-- Brand & Mission Column -->
      <div class="md:col-span-5 flex flex-col justify-between">
        <div>
          <span class="font-serif text-3xl tracking-tight text-[#1c1917] block">
            Astrology by Anisha
          </span>
          <span class="text-xs uppercase tracking-[0.25em] text-[#a37a4c] font-medium mt-1 block">
            Astrology &bull; Tarot &bull; Numerology
          </span>
          <p class="mt-4 text-[15px] leading-relaxed text-[#57534e] max-w-md font-light">
            Guiding pivotal life thresholds through the grounded wisdom of Vedic astrology, contemplative tarot archetypes, and sacred phonetic numerology. Designed as an intelligent, dignified container for self-knowledge.
          </p>
        </div>

        <div class="mt-8 flex items-center gap-4 text-xs tracking-wider uppercase text-[#857f77]">
          <span>New Delhi</span>
          <span>&bull;</span>
          <span>London</span>
          <span>&bull;</span>
          <span>Global Clients</span>
        </div>
      </div>

      <!-- Navigation Columns -->
      <div class="md:col-span-2 col-span-6">
        <h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-[#857f77] mb-5">
          Practices
        </h4>
        <ul class="space-y-3 text-[14px]">
          <li><a href="/astrology" class="text-[#57534e] hover:text-[#1c1917] transition-colors">Vedic Astrology</a></li>
          <li><a href="/tarot" class="text-[#57534e] hover:text-[#1c1917] transition-colors">Intuitive Tarot</a></li>
          <li><a href="/numerology" class="text-[#57534e] hover:text-[#1c1917] transition-colors">Sacred Numerology</a></li>
          <li><a href="/consultations" class="text-[#57534e] hover:text-[#1c1917] transition-colors">Private Advisory</a></li>
          <li><a href="/#birth-chart" class="text-[#a37a4c] hover:underline font-medium">Birth Chart Engine</a></li>
        </ul>
      </div>

      <div class="md:col-span-2 col-span-6">
        <h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-[#857f77] mb-5">
          Editorial
        </h4>
        <ul class="space-y-3 text-[14px]">
          <li><a href="/about" class="text-[#57534e] hover:text-[#1c1917] transition-colors">About Anisha</a></li>
          <li><a href="/articles" class="text-[#57534e] hover:text-[#1c1917] transition-colors">Articles & Essays</a></li>
          <li><a href="/articles/the-alchemy-of-sade-sati" class="text-[#57534e] hover:text-[#1c1917] transition-colors">Sade Sati Guide</a></li>
          <li><a href="/articles/understanding-your-lagna" class="text-[#57534e] hover:text-[#1c1917] transition-colors">Lagna Blueprint</a></li>
          <li><a href="/contact" class="text-[#57534e] hover:text-[#1c1917] transition-colors">Contact & Inquiries</a></li>
        </ul>
      </div>

      <!-- Newsletter / Journal Column -->
      <div class="md:col-span-3">
        <h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-[#857f77] mb-5">
          Cosmic Dispatches
        </h4>
        <p class="text-xs leading-relaxed text-[#57534e] mb-4">
          Thoughtful, sporadic essays on major planetary shifts, seasonal thresholds, and contemplative practices. No noise, no spam.
        </p>
        <form class="space-y-2.5" onsubmit="event.preventDefault(); alert('Thank you for subscribing to Cosmic Dispatches.');">
          <input
            type="email"
            placeholder="Your email address"
            required
            class="w-full px-3.5 py-2 text-xs rounded-lg bg-white/80 border border-[#28231e]/15 focus:outline-none focus:border-[#a37a4c] transition-colors"
          />
          <div class="pt-1">
            <GlassButton
              text="Receive Essays"
              type="submit"
              size="compact"
              width="100%"
            />
          </div>
        </form>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-[#857f77] gap-4">
      <p>&copy; {YEAR} Astrology by Anisha. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/contact" class="hover:text-[#1c1917] transition-colors">Privacy & Terms</a>
        <a href="/contact" class="hover:text-[#1c1917] transition-colors">Session Ethics</a>
        <span class="text-[#a37a4c]">&bull;</span>
        <span class="text-[#57534e]">Crafted for thoughtful seekers</span>
      </div>
    </div>
  </div>
</footer>
