---
interface Props {
  text: string;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  size?: 'large' | 'medium' | 'compact' | 'full';
  width?: string;
  height?: string;
  class?: string;
  id?: string;
  target?: string;
  ariaLabel?: string;
}

const {
  text,
  href,
  type = 'button',
  size = 'large',
  width,
  height,
  class: className = '',
  id,
  target,
  ariaLabel,
} = Astro.props;

const sizeClass =
  size === 'compact'
    ? 'iridescent-compact'
    : size === 'medium'
      ? 'iridescent-medium'
      : size === 'full'
        ? 'iridescent-full'
        : 'iridescent-large';

const inlineStyle = [
  width ? `width: ${width}; min-width: ${width};` : '',
  height ? `height: ${height};` : '',
]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a
      href={href}
      class={`iridescent ${sizeClass} ${className}`}
      id={id}
      target={target}
      aria-label={ariaLabel || text}
      style={inlineStyle || undefined}
    >
      <span class="btn-text">{text}</span>
      <span class="drop-shadow" aria-hidden="true" />
    </a>
  ) : (
    <button
      type={type}
      class={`iridescent ${sizeClass} ${className}`}
      id={id}
      aria-label={ariaLabel || text}
      style={inlineStyle || undefined}
    >
      <span class="btn-text">{text}</span>
      <span class="drop-shadow" aria-hidden="true" />
    </button>
  )
}

<script>
  // Dynamic refractive pointer tracking for optical crystal glass buttons
  if (typeof window !== 'undefined' && !window.__iridescentInitialized) {
    window.__iridescentInitialized = true;

    document.addEventListener('pointermove', (e) => {
      const target = (e.target as HTMLElement | null)?.closest('.iridescent') as HTMLElement | null;
      if (!target) return;
      const rect = target.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      target.style.setProperty('--x', `${x.toFixed(1)}%`);
      target.style.setProperty('--y', `${y.toFixed(1)}%`);
    });

    document.addEventListener('pointerout', (e) => {
      const target = (e.target as HTMLElement | null)?.closest('.iridescent') as HTMLElement | null;
      if (!target) return;
      target.style.removeProperty('--x');
      target.style.removeProperty('--y');
    });
  }
</script>
