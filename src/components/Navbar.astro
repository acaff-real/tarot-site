---
import GlassButton from './GlassButton.astro';
import ThemeToggle from './ThemeToggle.astro';
import BrandLogo from './BrandLogo.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const NAV_LINKS = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Articles', href: '/articles' },
  { label: 'Contact', href: '/contact' },
];
---

<header id="site-header" class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#fcfbf9]/90 dark:bg-[#0c091f]/90 border-b border-[#28231e]/5 dark:border-purple-500/20 transition-all duration-300">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16 h-18 sm:h-20 lg:h-22 flex items-center justify-between">
    
    <!-- Brand: Vector SVG Brand Logo -->
    <a href="/" class="flex items-center group text-left pr-3 sm:pr-6 py-1 select-none" aria-label="Astro by Anisha — Homepage">
      <BrandLogo />
    </a>

    <!-- Desktop Navigation Links: Restrained & airy across md, lg, xl -->
    <nav class="hidden md:flex items-center gap-4 lg:gap-8 xl:gap-10">
      {
        NAV_LINKS.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`text-[11.5px] lg:text-[12.5px] uppercase tracking-[0.12em] lg:tracking-[0.16em] font-medium transition-colors duration-150 py-2 ${
                isActive
                  ? 'text-[#a37a4c] dark:text-[#2dd4bf] font-semibold border-b border-[#a37a4c]/50 dark:border-[#2dd4bf]/50'
                  : 'text-[#57534e] dark:text-[#c4b5fd] hover:text-[#1c1917] dark:hover:text-[#2dd4bf]'
              }`}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Right Side Actions: Dedicated Consultation Booking & Theme Switcher -->
    <div class="hidden md:flex items-center gap-3 lg:gap-5 pl-2 lg:pl-4">
      <GlassButton
        text="Book a Consultation"
        href="/consultations"
        size="compact"
      />

      <ThemeToggle id="theme-toggle-desktop" />
    </div>

    <!-- Mobile Hamburger Toggle & Primary Booking Action -->
    <div class="flex md:hidden items-center gap-2 sm:gap-3">
      <ThemeToggle id="theme-toggle-mobile" />
      <div class="hidden sm:block">
        <GlassButton
          text="Book"
          href="/consultations"
          size="compact"
        />
      </div>
      <button
        type="button"
        id="mobile-menu-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="w-11 h-11 flex items-center justify-center rounded-full text-[#1c1917] dark:text-[#f8fafc] hover:bg-black/5 dark:hover:bg-white/10 transition-colors focus:outline-none cursor-pointer"
      >
        <svg class="w-6 h-6 menu-open-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="w-6 h-6 menu-close-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer (Smooth Animated Accordion) -->
  <div
    id="mobile-menu"
    class="md:hidden overflow-hidden max-h-0 opacity-0 transition-all duration-300 ease-out border-b border-transparent bg-[#fcfbf9]/98 dark:bg-[#0c091f]/98 backdrop-blur-xl px-8"
    aria-hidden="true"
  >
    <div class="py-6 flex flex-col gap-5">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="text-base text-[#1c1917] dark:text-[#f8fafc] hover:text-[#a37a4c] dark:hover:text-[#2dd4bf] font-medium py-1 transition-colors"
          >
            {link.label}
          </a>
        ))
      }
      <div class="pt-6 border-t border-[#28231e]/10 dark:border-purple-500/25 flex flex-col gap-4">
        <GlassButton
          text="Book a Consultation"
          href="/consultations"
          size="medium"
          width="100%"
        />
      </div>
    </div>
  </div>
</header>

<!-- Mobile Drawer Backdrop Overlay -->
<div
  id="mobile-backdrop"
  class="fixed inset-0 bg-black/45 backdrop-blur-xs z-40 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
  aria-hidden="true"
></div>

<script>
  function setupNavbar() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-backdrop');
    const header = document.getElementById('site-header');

    if (!btn || !menu) return;

    const openIcon = btn.querySelector('.menu-open-icon');
    const closeIcon = btn.querySelector('.menu-close-icon');

    function openMenu() {
      menu.classList.remove('max-h-0', 'opacity-0', 'border-transparent');
      menu.classList.add('max-h-[500px]', 'opacity-100', 'border-[#28231e]/10', 'dark:border-purple-500/25');

      if (backdrop) {
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
      }

      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
      menu.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      menu.classList.add('max-h-0', 'opacity-0', 'border-transparent');
      menu.classList.remove('max-h-[500px]', 'opacity-100', 'border-[#28231e]/10', 'dark:border-purple-500/25');

      if (backdrop) {
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      }

      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Replace button clone to clean up existing listeners
    const freshBtn = btn.cloneNode(true) as HTMLButtonElement;
    btn.parentNode?.replaceChild(freshBtn, btn);

    freshBtn.addEventListener('click', () => {
      const isOpen = freshBtn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close on backdrop click
    backdrop?.addEventListener('click', closeMenu);

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMenu();
      }
    });

    // Close menu when any internal link inside is clicked
    const links = menu.querySelectorAll('a');
    links.forEach((l) => {
      l.addEventListener('click', closeMenu);
    });

    // Sticky Scroll Elevation: subtle shadow past 10px scroll
    function handleScroll() {
      if (!header) return;
      if (window.scrollY > 10) {
        header.classList.add('shadow-xs', 'bg-[#fcfbf9]/98', 'dark:bg-[#0c091f]/98');
        header.classList.remove('bg-[#fcfbf9]/90', 'dark:bg-[#0c091f]/90');
      } else {
        header.classList.remove('shadow-xs', 'bg-[#fcfbf9]/98', 'dark:bg-[#0c091f]/98');
        header.classList.add('bg-[#fcfbf9]/90', 'dark:bg-[#0c091f]/90');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  document.addEventListener('astro:page-load', setupNavbar);
</script>
