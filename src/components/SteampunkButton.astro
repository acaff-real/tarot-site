---
interface Props {
  href?: string;
  text?: string;
  ariaLabel?: string;
  class?: string;
  tag?: 'button' | 'a';
}

const {
  href = '/consultations',
  text = 'Book a Consultation',
  ariaLabel = 'Book a Consultation',
  class: className = '',
  tag = 'a',
} = Astro.props;
---

{
  tag === 'button' ? (
    <button
      type="button"
      class={`iridescent iridescent-large ${className}`}
      aria-label={ariaLabel}
      onclick={`window.location.href='${href}'`}
    >
      <span class="btn-text">{text}</span>
      <span class="drop-shadow" aria-hidden="true" />
    </button>
  ) : (
    <a
      href={href}
      class={`iridescent iridescent-large ${className}`}
      aria-label={ariaLabel}
    >
      <span class="btn-text">{text}</span>
      <span class="drop-shadow" aria-hidden="true" />
    </a>
  )
}
