---
import { TAROT_DECK } from '../data/tarot';
import GlassButton from './GlassButton.astro';
---

<section id="tarot-card-of-day" class="py-16 sm:py-20 md:py-24 lg:py-28 bg-[#faf8f5] dark:bg-[#070512] border-t border-[#28231e]/10 dark:border-purple-500/20 relative overflow-hidden">
  <!-- Subtle ambient glow -->
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 sm:w-[32rem] h-96 sm:h-[32rem] rounded-full bg-[#f4eee4]/50 dark:bg-purple-900/10 blur-3xl pointer-events-none"></div>

  <div class="max-w-5xl xl:max-w-6xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-[11px] font-semibold uppercase tracking-[0.22em] bg-white/80 dark:bg-purple-950/40 border border-[#28231e]/10 dark:border-purple-500/30 text-[#a37a4c] dark:text-[#2dd4bf] mb-3 shadow-xs">
        <span>Contemplative Mirror</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#1c1917] dark:text-[#f8fafc] tracking-tight">
        Tarot Card of the Day
      </h2>
      <p class="mt-3 text-xs sm:text-sm md:text-base text-[#57534e] dark:text-[#c4b5fd] font-light leading-relaxed max-w-xl mx-auto">
        Pause, take a quiet breath, and pull an archetypal key to illuminate the subconscious currents guiding your day.
      </p>
    </div>

    <!-- Interactive Tarot Container -->
    <div class="glass-card rounded-2xl p-6 sm:p-8 md:p-10 lg:p-12 border border-[#28231e]/10 dark:border-purple-500/20 shadow-xl bg-white/70 dark:bg-[#0f0b24]/70 backdrop-blur-md">
      
      <!-- State 1: Deck & Draw Stage (Shown initially or when reshuffling) -->
      <div id="tarot-draw-stage" class="flex flex-col items-center justify-center py-6 sm:py-10 transition-all duration-500">
        
        <!-- Fanned Deck Cards -->
        <div id="deck-fan-container" class="relative w-64 sm:w-80 h-72 sm:h-88 flex items-center justify-center mb-8 cursor-pointer select-none">
          <!-- Card Backs Stack -->
          <div class="deck-card absolute w-36 sm:w-44 h-56 sm:h-68 rounded-xl shadow-lg border border-[#a37a4c]/30 overflow-hidden transition-all duration-500 transform -rotate-12 -translate-x-6 sm:-translate-x-10 translate-y-2 hover:-translate-y-2">
            <img src="/images/tarot/card-back.webp" alt="Tarot Card Back" class="w-full h-full object-cover" />
          </div>
          <div class="deck-card absolute w-36 sm:w-44 h-56 sm:h-68 rounded-xl shadow-lg border border-[#a37a4c]/30 overflow-hidden transition-all duration-500 transform -rotate-6 -translate-x-3 sm:-translate-x-5 translate-y-1 hover:-translate-y-2">
            <img src="/images/tarot/card-back.webp" alt="Tarot Card Back" class="w-full h-full object-cover" />
          </div>
          <div class="deck-card absolute w-36 sm:w-44 h-56 sm:h-68 rounded-xl shadow-2xl border border-[#a37a4c]/40 overflow-hidden transition-all duration-500 transform rotate-0 hover:-translate-y-3 z-10">
            <img src="/images/tarot/card-back.webp" alt="Tarot Card Back" class="w-full h-full object-cover" />
          </div>
          <div class="deck-card absolute w-36 sm:w-44 h-56 sm:h-68 rounded-xl shadow-lg border border-[#a37a4c]/30 overflow-hidden transition-all duration-500 transform rotate-6 translate-x-3 sm:translate-x-5 translate-y-1 hover:-translate-y-2">
            <img src="/images/tarot/card-back.webp" alt="Tarot Card Back" class="w-full h-full object-cover" />
          </div>
          <div class="deck-card absolute w-36 sm:w-44 h-56 sm:h-68 rounded-xl shadow-lg border border-[#a37a4c]/30 overflow-hidden transition-all duration-500 transform rotate-12 translate-x-6 sm:translate-x-10 translate-y-2 hover:-translate-y-2">
            <img src="/images/tarot/card-back.webp" alt="Tarot Card Back" class="w-full h-full object-cover" />
          </div>
        </div>

        <p class="text-xs sm:text-sm text-[#857f77] dark:text-[#a78bfa] font-light mb-6 text-center max-w-sm">
          Tap the deck or click below to shuffle and reveal today’s archetype.
        </p>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row items-center gap-3.5 sm:gap-4 w-full sm:w-auto">
          <button
            type="button"
            id="tarot-shuffle-btn"
            class="iridescent iridescent-medium w-full sm:w-auto px-6"
            aria-label="Shuffle and Pull Your Tarot Card of the Day"
          >
            <span class="btn-text">Shuffle & Pull Card</span>
            <span class="drop-shadow" aria-hidden="true" />
          </button>
        </div>

      </div>

      <!-- State 2: Revealed Card & Meaning (Hidden by default, smooth animated reveal) -->
      <div id="tarot-result-stage" class="hidden transition-all duration-700 ease-out">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 sm:gap-10 lg:gap-14 items-center">
          
          <!-- Card Display Column with 3D Flip -->
          <div class="md:col-span-5 lg:col-span-5 flex flex-col items-center">
            <div id="tarot-card-flip-wrap" class="perspective-1000 w-48 sm:w-56 md:w-60 lg:w-64 aspect-[360/600]">
              <div id="tarot-card-flipper" class="relative w-full h-full transform-style-3d transition-transform duration-700 rounded-xl shadow-2xl border border-[#a37a4c]/30 bg-white">
                
                <!-- Card Front Face -->
                <div class="absolute inset-0 backface-hidden rounded-xl overflow-hidden bg-white">
                  <img
                    id="tarot-card-img"
                    src="/images/tarot/the-sun.webp"
                    alt="Drawn Tarot Card"
                    class="w-full h-full object-cover"
                  />
                </div>
                
                <!-- Card Back Face -->
                <div class="absolute inset-0 backface-hidden rotate-y-180 rounded-xl overflow-hidden bg-[#1c1917]">
                  <img
                    src="/images/tarot/card-back.webp"
                    alt="Tarot Back"
                    class="w-full h-full object-cover"
                  />
                </div>

              </div>
            </div>

            <!-- Redraw Action -->
            <button
              type="button"
              id="tarot-redraw-btn"
              class="mt-6 text-xs font-semibold uppercase tracking-wider text-[#a37a4c] dark:text-[#2dd4bf] hover:underline cursor-pointer"
            >
              &circlearrowleft; Draw Another Card
            </button>
          </div>

          <!-- Card Meaning Column -->
          <div class="md:col-span-7 lg:col-span-7 flex flex-col items-start text-left space-y-5">
            
            <div>
              <div class="flex items-center gap-3 mb-2">
                <span id="tarot-card-num" class="text-xs font-semibold uppercase tracking-[0.2em] text-[#a37a4c] dark:text-[#2dd4bf]">
                  XIX • Major Arcana
                </span>
                <span class="text-xs text-[#857f77]">&bull;</span>
                <span id="tarot-card-archetype" class="text-xs font-serif italic text-[#857f77] dark:text-[#c4b5fd]">
                  The Golden Radiance
                </span>
              </div>
              <h3 id="tarot-card-name" class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[#1c1917] dark:text-[#f8fafc] tracking-tight">
                The Sun
              </h3>
            </div>

            <!-- Keywords Badges -->
            <div id="tarot-card-keywords" class="flex flex-wrap gap-2 pt-1">
              <!-- Injected dynamically -->
            </div>

            <!-- Meaning Paragraph -->
            <div class="space-y-3 pt-2">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-[#857f77] dark:text-[#a78bfa] block">
                Today's Archetypal Reflection
              </span>
              <p id="tarot-card-meaning" class="text-xs sm:text-sm md:text-base text-[#57534e] dark:text-[#e2e8f0] font-light leading-relaxed">
                The Sun dispels every shadow, bestowing warmth, vitality, and unmistakable transparency. Your efforts are illuminated; truth is obvious.
              </p>
            </div>

            <!-- Contemplative Question Box -->
            <div class="p-4 sm:p-5 rounded-xl bg-[#f5f2eb]/70 dark:bg-purple-950/30 border border-[#28231e]/10 dark:border-purple-500/20 w-full">
              <span class="text-[10px] font-semibold uppercase tracking-wider text-[#a37a4c] dark:text-[#2dd4bf] block mb-1">
                Contemplative Inquiry
              </span>
              <p id="tarot-card-inquiry" class="font-serif italic text-xs sm:text-sm text-[#1c1917] dark:text-[#f8fafc] leading-relaxed">
                "What joy or creative success is available for you to wholeheartedly celebrate today?"
              </p>
            </div>

            <!-- Affirmation & Consultation Link -->
            <div class="pt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 w-full border-t border-[#28231e]/10 dark:border-purple-500/20">
              <div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-[#857f77] dark:text-[#94a3b8] block">Daily Affirmation</span>
                <p id="tarot-card-affirmation" class="text-xs text-[#1c1917] dark:text-[#f8fafc] font-medium italic mt-0.5">
                  "I radiate warmth, joy, and clarity; my path is bright and clear."
                </p>
              </div>

              <GlassButton
                text="Book a Consultation"
                href="/consultations"
                size="compact"
              />
            </div>

          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<!-- Pass JSON dataset safely to browser script -->
<script define:vars={{ TAROT_DECK }}>
  function setupTarotCard() {
    const drawStage = document.getElementById('tarot-draw-stage');
    const resultStage = document.getElementById('tarot-result-stage');
    const fanContainer = document.getElementById('deck-fan-container');
    const shuffleBtn = document.getElementById('tarot-shuffle-btn');
    const redrawBtn = document.getElementById('tarot-redraw-btn');
    const flipper = document.getElementById('tarot-card-flipper');

    const cardImg = document.getElementById('tarot-card-img');
    const cardNum = document.getElementById('tarot-card-num');
    const cardArchetype = document.getElementById('tarot-card-archetype');
    const cardName = document.getElementById('tarot-card-name');
    const cardKeywords = document.getElementById('tarot-card-keywords');
    const cardMeaning = document.getElementById('tarot-card-meaning');
    const cardInquiry = document.getElementById('tarot-card-inquiry');
    const cardAffirmation = document.getElementById('tarot-card-affirmation');

    if (!shuffleBtn || !drawStage || !resultStage) return;

    let isShuffling = false;

    function pullCard() {
      if (isShuffling) return;
      isShuffling = true;

      // Animate deck shuffle
      const cards = fanContainer?.querySelectorAll('.deck-card');
      cards?.forEach((c, idx) => {
        c.style.transform = `translate(${(idx - 2) * 40}px, -20px) rotate(${(idx - 2) * 15}deg) scale(1.05)`;
      });

      setTimeout(() => {
        // Pick random card
        const randomIndex = Math.floor(Math.random() * TAROT_DECK.length);
        const card = TAROT_DECK[randomIndex];

        // Populate content
        if (cardImg) cardImg.src = card.image;
        if (cardNum) cardNum.textContent = `${card.number} • Major Arcana`;
        if (cardArchetype) cardArchetype.textContent = card.archetype;
        if (cardName) cardName.textContent = card.name;
        if (cardMeaning) cardMeaning.textContent = card.uprightMeaning;
        if (cardInquiry) cardInquiry.textContent = `"${card.contemplation}"`;
        if (cardAffirmation) cardAffirmation.textContent = `"${card.affirmation}"`;

        if (cardKeywords) {
          cardKeywords.innerHTML = card.keywords
            .map(
              (kw) =>
                `<span class="px-2.5 py-1 rounded-full text-[10px] font-medium bg-[#28231e]/5 dark:bg-purple-900/30 text-[#57534e] dark:text-[#c4b5fd] border border-[#28231e]/5 dark:border-purple-500/20">${kw}</span>`
            )
            .join('');
        }

        // Hide draw stage, show result stage
        drawStage.classList.add('hidden');
        resultStage.classList.remove('hidden');

        // Flip card with 3D animation
        if (flipper) {
          flipper.style.transform = 'rotateY(180deg)';
          setTimeout(() => {
            flipper.style.transform = 'rotateY(0deg)';
            isShuffling = false;
          }, 150);
        } else {
          isShuffling = false;
        }
      }, 600);
    }

    function resetDraw() {
      resultStage.classList.add('hidden');
      drawStage.classList.remove('hidden');
      const cards = fanContainer?.querySelectorAll('.deck-card');
      cards?.forEach((c) => {
        c.style.transform = '';
      });
    }

    shuffleBtn.addEventListener('click', pullCard);
    fanContainer?.addEventListener('click', pullCard);
    redrawBtn?.addEventListener('click', resetDraw);
  }

  setupTarotCard();
  document.addEventListener('astro:after-swap', setupTarotCard);
</script>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
  .transform-style-3d {
    transform-style: preserve-3d;
  }
  .backface-hidden {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .rotate-y-180 {
    transform: rotateY(180deg);
  }
</style>
