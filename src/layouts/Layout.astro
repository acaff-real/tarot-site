---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  image?: string;
  hideNavFooter?: boolean;
}

const {
  title = 'Astrology with Anisha — Vedic Astrology & Contemplative Tarot',
  description = 'High-precision Vedic birth chart calculations, contemplative tarot consultations, and grounded guidance by Anisha Banerji. Intelligent, modern spiritual clarity.',
  currentPath = Astro.url.pathname,
  image = '/images/og-image.jpg',
  hideNavFooter = false,
} = Astro.props;

const canonicalUrl = new URL(currentPath, Astro.site || 'https://astrobyanisha.com').href;
const ogImageUrl = new URL(image, Astro.site || 'https://astrobyanisha.com').href;
const isArticle = currentPath.startsWith('/articles/') && currentPath !== '/articles/';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Astrology with Anisha',
  alternateName: ['Astrology With Anisha', 'Anisha Banerji Astrology', 'Astro by Anisha'],
  url: 'https://astrobyanisha.com',
  description: 'Contemporary Vedic astrology, high-precision astronomical birth chart calculations, and contemplative tarot consultations with Anisha Banerji.',
  publisher: {
    '@type': 'Person',
    name: 'Anisha Banerji'
  }
};

const professionalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Astrology with Anisha',
  url: 'https://astrobyanisha.com',
  logo: 'https://astrobyanisha.com/favicon.svg',
  image: 'https://astrobyanisha.com/images/og-image.jpg',
  description: 'Grounded Vedic astrology, Chaldean numerology, and contemplative tarot consultations by Anisha Banerji.',
  founder: {
    '@type': 'Person',
    name: 'Anisha Banerji',
    jobTitle: 'Vedic Astrologer & Contemplative Tarot Consultant',
    sameAs: [
      'https://www.instagram.com/tarotbyanisha/',
      'https://www.youtube.com/tarotbyanisha',
      'https://twitter.com/tarotbyanishaa',
      'https://www.facebook.com/Tarotbyanisha',
      'https://www.linkedin.com/in/tarotbyanisha/'
    ]
  },
  email: 'anishabanerji@gmail.com',
  areaServed: 'Worldwide',
  knowsAbout: [
    'Vedic Astrology (Parashari Jyotish)',
    'Western Astrology (Tropical)',
    'Vimshottari Dasha Timing',
    'Kundali Chart Calculation',
    'Contemplative Tarot',
    'Chaldean Numerology'
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={currentPath === '/404' ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />

    <!-- Favicon & PWA App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fcfbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#060410" media="(prefers-color-scheme: dark)" />

    <!-- Primary Metadata -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Anisha Banerji" />

    <!-- Open Graph / Facebook / WhatsApp / iMessage -->
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1376" />
    <meta property="og:image:height" content="768" />
    <meta property="og:image:alt" content="Astrology with Anisha — Vedic Astrology & Contemplative Tarot" />
    <meta property="og:site_name" content="Astrology with Anisha" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@tarotbyanishaa" />
    <meta name="twitter:creator" content="@tarotbyanishaa" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Astrology with Anisha — Vedic Astrology & Contemplative Tarot" />

    <!-- Structured Data (JSON-LD) for Search Engine Rich Results -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(professionalServiceSchema)} />

    <!-- Instant Client-Side SPA Transitions -->
    <ClientRouter />

    <!-- Google Fonts: Cormorant Garamond & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Dark Mode Anti-Flicker Initialization & Transition Preservation (Strict Light Mode Default) -->
    <script is:inline>
      function applyTheme() {
        try {
          // Permanently purge any legacy dark mode keys in localStorage to prevent sticky dark mode
          localStorage.removeItem('theme');
          localStorage.removeItem('astro_theme_v2_initialized');

          // Strict Light Mode Default: only activate dark if explicitly toggled in this active tab session
          const sessionTheme = sessionStorage.getItem('astro_theme');
          if (sessionTheme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {
          document.documentElement.classList.remove('dark');
        }
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="bg-[#fcfbf9] dark:bg-[#060410] text-[#110f0d] dark:text-[#ffffff] selection:bg-[#855b25]/20 selection:text-[#110f0d] dark:selection:bg-[#e5c98f]/25 dark:selection:text-[#ffffff] min-h-screen flex flex-col antialiased">
    {!hideNavFooter && <Navbar currentPath={currentPath} />}
    <main class="flex-grow">
      <slot />
    </main>
    {!hideNavFooter && <Footer />}
  </body>
</html>
