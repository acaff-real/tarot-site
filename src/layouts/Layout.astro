---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  image?: string;
}

const {
  title = 'Astro by Anisha — Vedic Astrology & Contemplative Tarot',
  description = 'High-precision Vedic birth chart calculations, contemplative tarot consultations, and grounded guidance by Anisha Banerji. Intelligent, modern spiritual clarity.',
  currentPath = Astro.url.pathname,
  image = '/images/anisha.webp',
} = Astro.props;

const canonicalUrl = new URL(currentPath, Astro.site || 'https://astrobyanisha.com').href;
const ogImageUrl = new URL(image, Astro.site || 'https://astrobyanisha.com').href;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Astro by Anisha',
  url: 'https://astrobyanisha.com',
  image: 'https://astrobyanisha.com/images/anisha.webp',
  description: 'Grounded Vedic astrology and contemplative tarot consultations by Anisha Banerji.',
  founder: {
    '@type': 'Person',
    name: 'Anisha Banerji',
    jobTitle: 'Vedic Astrologer & Tarot Consultant',
    sameAs: ['https://instagram.com/astrobyanisha']
  },
  email: 'anishabanerji@gmail.com'
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data (JSON-LD) for Search Engine Rich Results -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />

    <!-- Instant Client-Side SPA Transitions -->
    <ClientRouter />

    <!-- Google Fonts: Cormorant Garamond & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Dark Mode Anti-Flicker Initialization & Transition Preservation (Strict Light Mode Default) -->
    <script is:inline>
      function applyTheme() {
        try {
          // Permanently purge any legacy dark mode keys in localStorage to prevent sticky dark mode
          localStorage.removeItem('theme');
          localStorage.removeItem('astro_theme_v2_initialized');

          // Strict Light Mode Default: only activate dark if explicitly toggled in this active tab session
          const sessionTheme = sessionStorage.getItem('astro_theme');
          if (sessionTheme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {
          document.documentElement.classList.remove('dark');
        }
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="bg-[#fcfbf9] dark:bg-[#060410] text-[#110f0d] dark:text-[#ffffff] selection:bg-[#855b25]/20 selection:text-[#110f0d] dark:selection:bg-[#e5c98f]/25 dark:selection:text-[#ffffff] min-h-screen flex flex-col antialiased">
    <Navbar currentPath={currentPath} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
