---
import Layout from '../layouts/Layout.astro';
import GlassButton from '../components/GlassButton.astro';
---

<Layout
  title="Page Not Found — Astrology with Anisha"
  description="The celestial coordinate you are looking for does not exist or has shifted."
  currentPath="/404"
>
  <section class="min-h-[70vh] flex flex-col justify-center py-20 px-4 sm:px-6 lg:px-8 bg-[#faf8f5]">
    <div class="max-w-xl mx-auto w-full mb-6 text-left">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs uppercase tracking-wider text-[#5a534b] dark:text-[#a8a29a] hover:text-[#110f0d] dark:hover:text-[#ffffff] transition-colors font-medium select-none"
        aria-label="Back to homepage"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Home</span>
      </a>
    </div>

    <div class="max-w-xl mx-auto text-center">
      <span class="text-xs uppercase tracking-[0.3em] text-[#a37a4c] font-semibold block mb-4">
        Celestial Coordinate Uncharted
      </span>
      <h1 class="font-serif text-6xl sm:text-7xl md:text-8xl text-[#1c1917] tracking-tight font-light mb-6">
        404
      </h1>
      <p class="text-base sm:text-lg text-[#57534e] font-light leading-relaxed mb-8 max-w-md mx-auto">
        The threshold you are seeking has shifted or remains unmapped. Return to familiar celestial ground or begin an inquiry.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <GlassButton href="/" variant="primary">
          Return Home
        </GlassButton>
        <GlassButton href="/consultations" variant="secondary">
          Book a Consultation
        </GlassButton>
      </div>
    </div>
  </section>
</Layout>
