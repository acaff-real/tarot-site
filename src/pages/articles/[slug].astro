---
import Layout from '../../layouts/Layout.astro';
import GlassButton from '../../components/GlassButton.astro';
import { getCollection, render } from 'astro:content';
import { marked } from 'marked';
import { getDatabase } from '../../lib/db';

export const prerender = false;

/** Sanitize HTML output from marked to prevent stored XSS */
function sanitizeHtml(html: string): string {
  return html
    // Remove <script> tags and their contents
    .replace(/<script[\s\S]*?<\/script>/gi, '')
    // Remove standalone <script> opening/closing tags
    .replace(/<\/?script[^>]*>/gi, '')
    // Remove on* event handlers (onclick, onerror, onload, etc.)
    .replace(/\s+on[a-z]+\s*=\s*["'][^"']*["']/gi, '')
    .replace(/\s+on[a-z]+\s*=\s*[^\s>]+/gi, '')
    // Remove javascript: URLs in href/src/action attributes
    .replace(/(href|src|action)\s*=\s*["']\s*javascript\s*:[^"']*["']/gi, '$1=""')
    // Remove data: URLs in src (can execute JS in some contexts)
    .replace(/src\s*=\s*["']\s*data\s*:[^"']*["']/gi, 'src=""')
    // Remove <iframe>, <object>, <embed>, <form>, <base> tags
    .replace(/<\/?(iframe|object|embed|form|base|meta|link|style)[^>]*>/gi, '')
    // Remove <svg> with potential script execution
    .replace(/<svg[\s\S]*?<\/svg>/gi, '');
}

const { slug } = Astro.params;
const db = getDatabase();

let article: any = null;
let htmlContent = '';
let StaticContent: any = null;

if (db && slug) {
  try {
    const row = await db.prepare('SELECT * FROM articles WHERE slug = ?').bind(slug).first();
    if (row) {
      let tagsArray = [];
      try {
        tagsArray = typeof row.tags === 'string' ? JSON.parse(row.tags) : (row.tags || []);
      } catch {
        tagsArray = typeof row.tags === 'string' ? row.tags.split(',').map((t: string) => t.trim()) : [];
      }
      article = {
        id: row.slug,
        data: {
          title: row.title,
          excerpt: row.excerpt,
          category: row.category,
          date: row.date,
          readingTime: row.reading_time,
          featuredImage: row.featured_image,
          tags: tagsArray,
        },
      };
      const rawHtml = await marked.parse(row.content || '');
      htmlContent = sanitizeHtml(rawHtml);
    }
  } catch (e) {
    console.error('D1 single article lookup error:', e);
  }
}

if (!article && slug) {
  try {
    const staticArticles = await getCollection('articles');
    const found = staticArticles.find((a) => a.id === slug);
    if (found) {
      article = found;
      const rendered = await render(found);
      StaticContent = rendered.Content;
    }
  } catch (e) {
    // static collection error fallback
  }
}

if (!article) {
  return Astro.redirect('/articles', 302);
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.data.title,
  description: article.data.excerpt,
  image: new URL(article.data.featuredImage || '/images/studio.jpg', Astro.site || 'https://astrobyanisha.com').href,
  datePublished: article.data.date,
  author: {
    '@type': 'Person',
    name: 'Anisha Banerji',
    jobTitle: 'Vedic Astrologer & Tarot Consultant',
    url: 'https://astrobyanisha.com/about'
  },
  publisher: {
    '@type': 'Organization',
    name: 'Astrology with Anisha',
    url: 'https://astrobyanisha.com',
    logo: 'https://astrobyanisha.com/favicon.svg'
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/articles/${article.id}`, Astro.site || 'https://astrobyanisha.com').href
  }
};
---

<Layout
  title={`${article.data.title} — Astrology with Anisha`}
  description={article.data.excerpt}
  currentPath={`/articles/${article.id}`}
  image={article.data.featuredImage}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />

  <!-- Article Header -->
  <article class="py-12 sm:py-16 md:py-20 lg:py-24 bg-[#fcfbf9] dark:bg-[#060410] border-b border-[#28231e]/10 dark:border-purple-500/20">
    <div class="max-w-3xl lg:max-w-4xl xl:max-w-5xl mx-auto px-4 sm:px-6 md:px-8">
      
      <!-- Back Links -->
      <div class="flex items-center gap-3 text-xs uppercase tracking-wider mb-8 font-medium select-none">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-[#5a534b] dark:text-[#a8a29a] hover:text-[#110f0d] dark:hover:text-[#ffffff] transition-colors"
          aria-label="Back to homepage"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Home</span>
        </a>
        <span class="text-[#28231e]/25 dark:text-purple-500/30">/</span>
        <a
          href="/articles"
          class="text-[#5a534b] dark:text-[#a8a29a] hover:text-[#110f0d] dark:hover:text-[#ffffff] transition-colors"
        >
          All Essays
        </a>
      </div>

      <!-- Category & Reading Time -->
      <div class="flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-[#855b25] dark:text-[#e5c98f] font-semibold mb-4">
        <span>{article.data.category}</span>
        <span>&bull;</span>
        <span>{article.data.readingTime}</span>
      </div>

      <!-- Title -->
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-[#110f0d] dark:text-[#ffffff] tracking-tight leading-[1.15] mb-6 font-medium">
        {article.data.title}
      </h1>

      <!-- Date & Author Meta -->
      <div class="flex items-center gap-4 py-4 border-y border-[#28231e]/15 dark:border-purple-500/20 text-xs text-[#5a534b] dark:text-[#a8a29a] mb-10 font-medium">
        <span class="font-semibold text-[#110f0d] dark:text-[#ffffff]">By Anisha Banerji</span>
        <span>&bull;</span>
        <span>{article.data.date}</span>
      </div>

      <!-- Featured Image -->
      <div class="rounded-xl overflow-hidden border border-[#28231e]/15 dark:border-purple-500/25 shadow-lg mb-12 aspect-[16/10] bg-[#e8e2d5] dark:bg-[#120d2c]">
        <img
          src={article.data.featuredImage}
          alt={article.data.title}
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Article Body -->
      <div class="article-body max-w-none text-[#2c2722] dark:text-[#ded9d0]">
        {htmlContent ? (
          <div set:html={htmlContent} />
        ) : StaticContent ? (
          <div>
            <StaticContent />
          </div>
        ) : null}
      </div>

      <!-- Article Footer Tags -->
      <div class="mt-12 pt-8 border-t border-[#28231e]/15 dark:border-purple-500/20 flex flex-wrap gap-2">
        {
          article.data.tags.map((tag: string) => (
            <span class="px-3 py-1 rounded-md text-xs bg-[#28231e]/5 dark:bg-purple-950/50 text-[#38322c] dark:text-[#ded9d0] border border-[#28231e]/10 dark:border-purple-500/25 font-medium">
              #{tag}
            </span>
          ))
        }
      </div>

      <!-- Author Bio Card -->
      <div class="mt-12 p-8 rounded-xl bg-white/90 dark:bg-[#0f0b24]/90 border border-[#28231e]/15 dark:border-purple-500/25 shadow-xs flex flex-col sm:flex-row items-center gap-6">
        <div class="w-20 h-20 rounded-md overflow-hidden flex-shrink-0 border border-[#28231e]/15 dark:border-purple-500/30">
          <img src="/images/anisha.webp" alt="Anisha Banerji" class="w-full h-full object-cover" />
        </div>
        <div>
          <span class="font-serif text-xl text-[#110f0d] dark:text-[#ffffff] font-medium block">Anisha Banerji</span>
          <p class="text-xs text-[#38322c] dark:text-[#ded9d0] font-normal leading-relaxed mt-1">
            Vedic astrologer and intuitive tarot consultant. Working with private clients globally to guide life thresholds through clear astronomical timing and grounded counsel.
          </p>
          <div class="mt-3">
            <a href="/consultations" class="text-xs font-semibold uppercase tracking-wider text-[#855b25] dark:text-[#e5c98f] hover:underline">
              Book a Consultation with Anisha &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>
  </article>

  <style>
    .article-body {
      font-size: 1.125rem;
      line-height: 1.85;
      color: #2c2722;
    }
    :global(.dark) .article-body {
      color: #ded9d0;
    }

    /* Lead / First Paragraph */
    .article-body :global(p.lead),
    .article-body :global(> p:first-of-type),
    .article-body :global(> div > p:first-of-type) {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 1.35rem;
      line-height: 1.6;
      font-style: italic;
      color: #443e37;
      margin-bottom: 2rem;
      display: block;
    }
    @media (min-width: 640px) {
      .article-body :global(p.lead),
      .article-body :global(> p:first-of-type),
      .article-body :global(> div > p:first-of-type) {
        font-size: 1.5rem;
      }
    }
    :global(.dark) .article-body :global(p.lead),
    :global(.dark) .article-body :global(> p:first-of-type),
    :global(.dark) .article-body :global(> div > p:first-of-type) {
      color: #f0ebe1;
    }

    /* Regular Paragraphs */
    .article-body :global(p) {
      margin-bottom: 1.5rem;
      line-height: 1.85;
    }

    /* Headings */
    .article-body :global(h1),
    .article-body :global(h2),
    .article-body :global(h3),
    .article-body :global(h4) {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 600;
      color: #110f0d;
      letter-spacing: -0.015em;
    }
    :global(.dark) .article-body :global(h1),
    :global(.dark) .article-body :global(h2),
    :global(.dark) .article-body :global(h3),
    :global(.dark) .article-body :global(h4) {
      color: #ffffff;
    }

    .article-body :global(h1) {
      font-size: 2.25rem;
      line-height: 1.2;
      margin-top: 3rem;
      margin-bottom: 1.25rem;
    }
    .article-body :global(h2) {
      font-size: 1.875rem;
      line-height: 1.25;
      margin-top: 2.75rem;
      margin-bottom: 1rem;
      border-bottom: 1px solid rgba(40, 35, 30, 0.08);
      padding-bottom: 0.5rem;
    }
    :global(.dark) .article-body :global(h2) {
      border-bottom-color: rgba(168, 85, 247, 0.2);
    }
    .article-body :global(h3) {
      font-size: 1.45rem;
      line-height: 1.3;
      margin-top: 2.25rem;
      margin-bottom: 0.75rem;
    }
    .article-body :global(h4) {
      font-size: 1.2rem;
      line-height: 1.4;
      margin-top: 1.75rem;
      margin-bottom: 0.5rem;
    }

    /* Blockquotes */
    .article-body :global(blockquote) {
      border-left: 3px solid #855b25;
      background: #faf8f5;
      padding: 1.5rem 1.75rem;
      margin: 2.25rem 0;
      border-radius: 0.5rem;
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 1.25rem;
      font-style: italic;
      color: #110f0d;
      line-height: 1.65;
      box-shadow: inset 0 0 0 1px rgba(133, 91, 37, 0.08);
    }
    @media (min-width: 640px) {
      .article-body :global(blockquote) {
        font-size: 1.35rem;
        padding: 1.75rem 2rem;
      }
    }
    :global(.dark) .article-body :global(blockquote) {
      border-left-color: #e5c98f;
      background: rgba(15, 11, 36, 0.7);
      color: #ffffff;
      box-shadow: inset 0 0 0 1px rgba(229, 201, 143, 0.15);
    }
    .article-body :global(blockquote p) {
      margin-bottom: 0.75rem;
      line-height: 1.65;
    }
    .article-body :global(blockquote p:last-child) {
      margin-bottom: 0;
    }

    /* Unordered Lists */
    .article-body :global(ul) {
      list-style-type: disc !important;
      margin: 1.5rem 0 1.75rem 0 !important;
      padding-left: 1.75rem !important;
    }
    /* Ordered Lists */
    .article-body :global(ol) {
      list-style-type: decimal !important;
      margin: 1.5rem 0 1.75rem 0 !important;
      padding-left: 1.75rem !important;
    }
    .article-body :global(li) {
      margin-bottom: 0.5rem;
      line-height: 1.75;
      padding-left: 0.25rem;
    }
    .article-body :global(li strong),
    .article-body :global(li b) {
      color: #110f0d;
      font-weight: 600;
    }
    :global(.dark) .article-body :global(li strong),
    :global(.dark) .article-body :global(li b) {
      color: #ffffff;
    }

    /* Inline Formatting */
    .article-body :global(strong),
    .article-body :global(b) {
      font-weight: 600;
      color: #110f0d;
    }
    :global(.dark) .article-body :global(strong),
    :global(.dark) .article-body :global(b) {
      color: #ffffff;
    }
    .article-body :global(em),
    .article-body :global(i) {
      font-style: italic;
    }

    /* Links */
    .article-body :global(a) {
      color: #855b25;
      text-decoration: underline;
      text-underline-offset: 3px;
      font-weight: 500;
      transition: color 0.15s ease;
    }
    .article-body :global(a:hover) {
      color: #5d3f18;
    }
    :global(.dark) .article-body :global(a) {
      color: #e5c98f;
    }
    :global(.dark) .article-body :global(a:hover) {
      color: #f5e4bd;
    }

    /* Images */
    .article-body :global(img) {
      border-radius: 0.75rem;
      margin: 2.25rem auto;
      max-width: 100%;
      height: auto;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      display: block;
      border: 1px solid rgba(40, 35, 30, 0.1);
    }
    :global(.dark) .article-body :global(img) {
      border-color: rgba(168, 85, 247, 0.2);
    }

    /* Dividers */
    .article-body :global(hr) {
      border: 0;
      border-top: 1px solid rgba(133, 91, 37, 0.25);
      margin: 2.75rem 0;
    }
    :global(.dark) .article-body :global(hr) {
      border-top-color: rgba(229, 201, 143, 0.25);
    }
  </style>
</Layout>
