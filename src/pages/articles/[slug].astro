---
import Layout from '../../layouts/Layout.astro';
import GlassButton from '../../components/GlassButton.astro';
import { ARTICLES, type Article } from '../../data/articles';

export function getStaticPaths() {
  return ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<Layout
  title={`${article.title} — Astro by Anisha`}
  description={article.excerpt}
  currentPath="/articles"
>
  <!-- Article Header -->
  <article class="py-16 lg:py-24 bg-[#fcfbf9]">
    <div class="max-w-3xl mx-auto px-6 sm:px-8">
      
      <!-- Back Link -->
      <a href="/articles" class="inline-flex items-center gap-1.5 text-xs uppercase tracking-wider text-[#857f77] hover:text-[#1c1917] mb-8 transition-colors">
        &larr; Back to all essays
      </a>

      <!-- Category & Reading Time -->
      <div class="flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-[#a37a4c] font-semibold mb-4">
        <span>{article.category}</span>
        <span>&bull;</span>
        <span>{article.readingTime}</span>
      </div>

      <!-- Title -->
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-[#1c1917] tracking-tight leading-[1.12] mb-6">
        {article.title}
      </h1>

      <!-- Date & Author Meta -->
      <div class="flex items-center gap-4 py-4 border-y border-[#28231e]/10 text-xs text-[#57534e] mb-10">
        <span class="font-semibold text-[#1c1917]">By Anisha Banerji</span>
        <span>&bull;</span>
        <span>{article.date}</span>
      </div>

      <!-- Featured Image -->
      <div class="rounded-xl overflow-hidden border border-[#28231e]/10 shadow-lg mb-12 aspect-[16/10] bg-[#e8e2d5]">
        <img
          src={article.featuredImage}
          alt={article.title}
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Article Body -->
      <div class="prose prose-stone max-w-none text-[#3a3734] font-light leading-relaxed text-base sm:text-lg space-y-6 [&>p.lead]:font-serif [&>p.lead]:text-2xl [&>p.lead]:text-[#1c1917] [&>p.lead]:leading-snug [&>h2]:font-serif [&>h2]:text-3xl [&>h2]:text-[#1c1917] [&>h2]:mt-10 [&>h2]:mb-4 [&>blockquote]:border-l-2 [&>blockquote]:border-[#a37a4c] [&>blockquote]:pl-6 [&>blockquote]:italic [&>blockquote]:my-8 [&>blockquote]:font-serif [&>blockquote]:text-xl [&>blockquote]:text-[#1c1917] [&>ul]:space-y-2 [&>ol]:space-y-2">
        <Fragment set:html={article.content} />
      </div>

      <!-- Article Footer Tags -->
      <div class="mt-12 pt-8 border-t border-[#28231e]/10 flex flex-wrap gap-2">
        {
          article.tags.map((tag) => (
            <span class="px-3 py-1 rounded-md text-xs bg-black/[0.03] text-[#57534e] border border-[#28231e]/5">
              #{tag}
            </span>
          ))
        }
      </div>

      <!-- Author Bio Card -->
      <div class="mt-12 p-8 rounded-xl bg-[#faf8f5] border border-[#28231e]/10 flex flex-col sm:flex-row items-center gap-6">
        <div class="w-20 h-20 rounded-md overflow-hidden flex-shrink-0 border border-[#28231e]/10">
          <img src="/images/anisha.webp" alt="Anisha Banerji" class="w-full h-full object-cover" />
        </div>
        <div>
          <span class="font-serif text-xl text-[#1c1917] font-medium block">Anisha Banerji</span>
          <p class="text-xs text-[#57534e] font-light leading-relaxed mt-1">
            Vedic astrologer and intuitive tarot consultant. Working with private clients globally to guide life thresholds through clear astronomical timing and grounded counsel.
          </p>
          <div class="mt-3">
            <a href="/consultations" class="text-xs font-semibold uppercase tracking-wider text-[#a37a4c] hover:underline">
              Book a Consultation with Anisha &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>
  </article>
</Layout>
