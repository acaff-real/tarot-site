---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
---

<Layout
  title="Articles & Reflections — Astro by Anisha"
  description="Thoughtful essays on Vedic astrology, Sade Sati, the Lagna blueprint, intuitive tarot archetypes, and timing by Anisha Banerji."
  currentPath="/articles"
>
  <!-- Header -->
  <section class="pt-12 pb-10 sm:pt-16 sm:pb-14 md:pt-20 md:pb-16 lg:pt-24 lg:pb-20 bg-[#fcfbf9] border-b border-[#28231e]/10">
    <div class="max-w-4xl xl:max-w-5xl mx-auto px-4 sm:px-6 md:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-md text-xs font-semibold uppercase tracking-[0.2em] bg-white border border-[#28231e]/10 text-[#a37a4c] mb-4">
        <span>Essays & Inquiries</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-[#1c1917] tracking-tight leading-tight">
        Articles & Reflections
      </h1>
      <p class="mt-4 text-sm sm:text-base md:text-lg text-[#57534e] font-light max-w-2xl mx-auto leading-relaxed">
        Contemplative essays designed to demystify ancient celestial sciences and offer grounded perspectives for modern living.
      </p>
    </div>
  </section>

  <!-- Articles Grid -->
  <section class="py-14 sm:py-18 md:py-20 lg:py-24 xl:py-28 bg-[#faf8f5]">
    <div class="max-w-6xl xl:max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 lg:gap-10">
        {
          articles.map((art) => (
            <article class="glass-card rounded-lg overflow-hidden border border-[#28231e]/10 bg-white/80 flex flex-col justify-between">
              <div>
                <div class="aspect-[16/9] overflow-hidden bg-[#e8e2d5]">
                  <img
                    src={art.data.featuredImage}
                    alt={art.data.title}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                  />
                </div>
                <div class="p-6 sm:p-7 md:p-8">
                  <div class="flex items-center gap-3 text-xs uppercase tracking-wider text-[#857f77] mb-3 font-semibold">
                    <span class="text-[#a37a4c]">{art.data.category}</span>
                    <span>&bull;</span>
                    <span>{art.data.readingTime}</span>
                  </div>

                  <h2 class="font-serif text-xl sm:text-2xl lg:text-3xl text-[#1c1917] font-medium leading-snug mb-3 hover:text-[#a37a4c] transition-colors">
                    <a href={`/articles/${art.id}`}>{art.data.title}</a>
                  </h2>

                  <p class="text-xs sm:text-sm text-[#57534e] font-light leading-relaxed mb-6">
                    {art.data.excerpt}
                  </p>
                </div>
              </div>

              <div class="px-8 pb-8 pt-2 border-t border-[#28231e]/5 flex items-center justify-between">
                <span class="text-xs text-[#857f77]">{art.data.date}</span>
                <a
                  href={`/articles/${art.id}`}
                  class="text-xs font-semibold uppercase tracking-wider text-[#1c1917] hover:text-[#a37a4c] transition-colors"
                >
                  Read Essay &rarr;
                </a>
              </div>
            </article>
          ))
        }
      </div>

    </div>
  </section>
</Layout>
