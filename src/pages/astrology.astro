---
import Layout from '../layouts/Layout.astro';
import BirthChartCalculator from '../components/BirthChartCalculator.astro';
import GlassButton from '../components/GlassButton.astro';
---

<Layout
  title="Vedic Astrology & Birth Chart Engine — Astrology by Anisha"
  description="Explore authentic Sidereal Vedic Astrology (Jyotish) with high-precision Lahiri Ayanamsha calculations, Vimshottari Dasha analysis, and personal Kundali readings."
  currentPath="/astrology"
>
  <!-- Header -->
  <section class="pt-16 pb-14 lg:pt-24 lg:pb-20 bg-[#fcfbf9] border-b border-[#28231e]/10">
    <div class="max-w-4xl mx-auto px-6 sm:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold uppercase tracking-[0.2em] bg-white border border-[#28231e]/10 text-[#a37a4c] mb-4">
        <span>Sacred Science of Light</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-[#1c1917] tracking-tight leading-tight">
        Vedic Astrology (Jyotish)
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[#57534e] font-light max-w-2xl mx-auto leading-relaxed">
        Jyotish translates from Sanskrit as "the science of light." It is an ancient observational science decoding the geometric resonance between the cosmos and human consciousness.
      </p>
    </div>
  </section>

  <!-- Key Pillars Section -->
  <section class="py-16 lg:py-20 bg-[#faf8f5]">
    <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="font-serif text-3xl sm:text-4xl text-[#1c1917]">
          The Nirayana (Sidereal) Architecture
        </h2>
        <p class="text-sm text-[#57534e] font-light mt-3 leading-relaxed">
          Unlike Western tropical astrology, which fixes 0° Aries to the vernal equinox regardless of stellar movement, Vedic astrology uses the <strong>Sidereal Zodiac (Nirayana)</strong>, accounting for the axial precession of the equinoxes through the Lahiri Ayanamsha (~24° difference).
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 rounded-2xl bg-white border border-[#28231e]/10 shadow-xs">
          <div class="text-xs uppercase tracking-widest text-[#a37a4c] font-semibold mb-2">Pillar I</div>
          <h3 class="font-serif text-2xl text-[#1c1917] mb-3">The Lagna (Ascendant)</h3>
          <p class="text-xs sm:text-sm text-[#57534e] font-light leading-relaxed">
            The degree rising in the east at your birth. The Lagna defines the first house of self, physical vitality, constitution, and establishes the blueprint of all remaining eleven houses.
          </p>
        </div>

        <div class="p-8 rounded-2xl bg-white border border-[#28231e]/10 shadow-xs">
          <div class="text-xs uppercase tracking-widest text-[#a37a4c] font-semibold mb-2">Pillar II</div>
          <h3 class="font-serif text-2xl text-[#1c1917] mb-3">Chandra & Nakshatras</h3>
          <p class="text-xs sm:text-sm text-[#57534e] font-light leading-relaxed">
            The Moon represents the perceptual mind (<em>Manas</em>). Your natal Moon’s placement within one of the 27 Nakshatras (lunar mansions) activates your intuitive capacity and psychological sanctuary.
          </p>
        </div>

        <div class="p-8 rounded-2xl bg-white border border-[#28231e]/10 shadow-xs">
          <div class="text-xs uppercase tracking-widest text-[#a37a4c] font-semibold mb-2">Pillar III</div>
          <h3 class="font-serif text-2xl text-[#1c1917] mb-3">Vimshottari Dasha Cycles</h3>
          <p class="text-xs sm:text-sm text-[#57534e] font-light leading-relaxed">
            Vedic astrology's crowning jewel: a 120-year planetary timing framework that reveals when specific houses and karmic themes awaken throughout your adult life.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Embedded Calculator -->
  <BirthChartCalculator />

  <!-- CTA Box -->
  <section class="py-16 bg-[#fcfbf9] text-center border-t border-[#28231e]/10">
    <div class="max-w-2xl mx-auto px-6">
      <h3 class="font-serif text-3xl text-[#1c1917] mb-3">
        Book a 1-on-1 Natal Reading
      </h3>
      <p class="text-sm text-[#57534e] font-light mb-8 leading-relaxed">
        Let us map your upcoming planetary cycles, D9 Navamsha relationship chart, and career timing with utmost precision.
      </p>
      <GlassButton
        text="Schedule Vedic Reading"
        href="/consultations"
      />
    </div>
  </section>
</Layout>
