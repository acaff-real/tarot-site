---
import Layout from '../layouts/Layout.astro';
import BirthChartCalculator from '../components/BirthChartCalculator.astro';
import GlassButton from '../components/GlassButton.astro';
---

<Layout
  title="Vedic Astrology & Birth Chart Engine — Astrology with Anisha"
  description="Explore authentic Sidereal Vedic Astrology (Jyotish) with high-precision Lahiri Ayanamsha calculations, Vimshottari Dasha analysis, and personal Kundali readings."
  currentPath="/astrology"
>
  <!-- Header -->
  <section class="pt-8 pb-10 sm:pt-12 sm:pb-14 md:pt-14 md:pb-16 lg:pt-16 lg:pb-20 bg-[#fcfbf9] dark:bg-[#090716] border-b border-[#28231e]/10 dark:border-purple-500/20">
    <div class="max-w-4xl xl:max-w-6xl mx-auto px-4 sm:px-6 md:px-8">
      <!-- Back to Home Link -->
      <div class="mb-4 sm:mb-6 text-left">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs uppercase tracking-wider text-[#5a534b] dark:text-[#a8a29a] hover:text-[#110f0d] dark:hover:text-[#ffffff] transition-colors font-medium select-none"
          aria-label="Back to homepage"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Home</span>
        </a>
      </div>

      <div class="text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-md text-xs font-semibold uppercase tracking-[0.2em] bg-white/90 dark:bg-purple-950/60 border border-[#28231e]/15 dark:border-purple-500/30 text-[#855b25] dark:text-[#e5c98f] mb-4 shadow-xs">
          <span>Sacred Science of Light</span>
        </div>
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-[#110f0d] dark:text-[#ffffff] tracking-tight leading-tight font-medium">
          Vedic Astrology (Jyotish)
        </h1>
        <p class="mt-4 text-base sm:text-lg md:text-xl text-[#2c2722] dark:text-[#f0ebe1] font-normal max-w-2xl xl:max-w-3xl mx-auto leading-relaxed">
          Jyotish translates from Sanskrit as "the science of light." It is an ancient observational science decoding the geometric resonance between the cosmos and human consciousness.
        </p>
      </div>

      <!-- Link to Name Analysis towards bottom right of white section -->
      <div class="mt-6 sm:mt-8 flex justify-end">
        <a
          href="/numerology"
          class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-[#5a534b] dark:text-[#a8a29a] hover:text-[#855b25] dark:hover:text-[#e5c98f] transition-colors pt-2"
        >
          <span>Name Analysis</span>
          <span class="text-sm">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Key Pillars Section -->
  <section class="py-14 sm:py-18 md:py-20 lg:py-24 xl:py-28 bg-[#faf8f5] dark:bg-[#060410]">
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      <div class="text-center max-w-2xl xl:max-w-3xl mx-auto mb-10 sm:mb-14">
        <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl text-[#110f0d] dark:text-[#ffffff] font-medium">
          The Nirayana (Sidereal) Architecture
        </h2>
        <p class="text-sm sm:text-base text-[#38322c] dark:text-[#ded9d0] font-normal mt-3 leading-relaxed">
          Unlike Western tropical astrology, which fixes 0° Aries to the vernal equinox regardless of stellar movement, Vedic astrology uses the <strong class="text-[#110f0d] dark:text-[#ffffff]">Sidereal Zodiac (Nirayana)</strong>, accounting for the axial precession of the equinoxes through the Lahiri Ayanamsha (~24° difference).
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-6 md:gap-8">
        <div class="p-6 sm:p-7 md:p-8 rounded-xl bg-white/90 dark:bg-[#0f0b24]/90 border border-[#28231e]/15 dark:border-purple-500/25 shadow-xs">
          <div class="text-xs uppercase tracking-widest text-[#855b25] dark:text-[#e5c98f] font-semibold mb-2">Pillar I</div>
          <h3 class="font-serif text-2xl text-[#110f0d] dark:text-[#ffffff] font-medium mb-3">The Lagna (Ascendant)</h3>
          <p class="text-sm text-[#38322c] dark:text-[#ded9d0] font-normal leading-relaxed">
            The degree rising in the east at your birth. The Lagna defines the first house of self, physical vitality, constitution, and establishes the blueprint of all remaining eleven houses.
          </p>
        </div>

        <div class="p-6 sm:p-7 md:p-8 rounded-xl bg-white/90 dark:bg-[#0f0b24]/90 border border-[#28231e]/15 dark:border-purple-500/25 shadow-xs">
          <div class="text-xs uppercase tracking-widest text-[#855b25] dark:text-[#e5c98f] font-semibold mb-2">Pillar II</div>
          <h3 class="font-serif text-2xl text-[#110f0d] dark:text-[#ffffff] font-medium mb-3">Chandra & Nakshatras</h3>
          <p class="text-sm text-[#38322c] dark:text-[#ded9d0] font-normal leading-relaxed">
            The Moon represents the perceptual mind (<em>Manas</em>). Your natal Moon’s placement within one of the 27 Nakshatras (lunar mansions) activates your intuitive capacity and psychological sanctuary.
          </p>
        </div>

        <div class="p-6 sm:p-7 md:p-8 rounded-xl bg-white/90 dark:bg-[#0f0b24]/90 border border-[#28231e]/15 dark:border-purple-500/25 shadow-xs">
          <div class="text-xs uppercase tracking-widest text-[#855b25] dark:text-[#e5c98f] font-semibold mb-2">Pillar III</div>
          <h3 class="font-serif text-2xl text-[#110f0d] dark:text-[#ffffff] font-medium mb-3">Vimshottari Dasha Cycles</h3>
          <p class="text-sm text-[#38322c] dark:text-[#ded9d0] font-normal leading-relaxed">
            Vedic astrology's crowning jewel: a 120-year planetary timing framework that reveals when specific houses and karmic themes awaken throughout your adult life.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Embedded Calculator -->
  <BirthChartCalculator />

  <!-- CTA Box -->
  <section class="py-16 sm:py-20 bg-[#fcfbf9] dark:bg-[#090716] text-center border-t border-[#28231e]/10 dark:border-purple-500/20">
    <div class="max-w-2xl xl:max-w-3xl mx-auto px-6">
      <h3 class="font-serif text-3xl sm:text-4xl text-[#110f0d] dark:text-[#ffffff] mb-3 font-medium">
        Book a 1-on-1 Natal Reading
      </h3>
      <p class="text-sm sm:text-base text-[#38322c] dark:text-[#ded9d0] font-normal mb-8 leading-relaxed">
        Let us map your upcoming planetary cycles, D9 Navamsha relationship chart, and career timing with utmost precision.
      </p>
      <GlassButton
        text="Book a Consultation"
        href="/consultations"
      />
    </div>
  </section>
</Layout>
