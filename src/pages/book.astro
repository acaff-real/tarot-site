---
import Layout from '../layouts/Layout.astro';
import GlassButton from '../components/GlassButton.astro';
---

<Layout
  title="The Book — Astro by Anisha"
  description="The forthcoming book by Anisha Banerji. A contemporary contemplation on Vedic planetary timing, archetypal tarot, and self-knowledge."
  currentPath="/book"
>
  <!-- Hero Section -->
  <section class="pt-12 pb-16 sm:pt-16 sm:pb-20 md:pt-20 md:pb-24 lg:pt-24 lg:pb-32 bg-[#fcfbf9] dark:bg-[#060410] border-b border-[#28231e]/10 dark:border-purple-500/20 relative overflow-hidden">
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      <div class="grid grid-cols-1 md:grid-cols-12 lg:grid-cols-12 gap-10 md:gap-12 lg:gap-16 items-center">
        
        <!-- Left: Book Information -->
        <div class="md:col-span-7 lg:col-span-7 xl:col-span-8 flex flex-col items-start">
          <span class="text-xs uppercase tracking-[0.25em] text-[#855b25] dark:text-[#e5c98f] font-semibold block mb-3">
            Forthcoming Publication
          </span>
          <h1 class="font-serif text-4xl sm:text-5xl md:text-5xl lg:text-6xl xl:text-7xl text-[#110f0d] dark:text-[#ffffff] tracking-tight leading-[1.08] mb-5 sm:mb-6 font-medium">
            The Sacred Mirror
          </h1>
          <p class="font-serif text-xl sm:text-2xl text-[#2c2722] dark:text-[#f0ebe1] font-normal leading-snug mb-5 max-w-2xl">
            Navigating life's pivotal seasons through Vedic wisdom and contemplative archetypes.
          </p>
          <p class="text-sm sm:text-base text-[#38322c] dark:text-[#ded9d0] font-normal leading-relaxed mb-8 max-w-2xl">
            Authored by Anisha Banerji, this forthcoming work bridges classical astronomical ephemeris and psychological nuance—offering thoughtful seekers a timeless framework for understanding their internal timing and sovereign crossroads.
          </p>

          <!-- Waitlist Form (Lands directly on anishabanerji@gmail.com) -->
          <div class="w-full max-w-lg p-6 sm:p-7 rounded-xl bg-white/90 dark:bg-[#0f0b24]/90 border border-[#28231e]/15 dark:border-purple-500/25 shadow-xs">
            <span class="text-xs font-semibold uppercase tracking-wider text-[#110f0d] dark:text-[#ffffff] block mb-2">
              Join the Priority Release Waitlist
            </span>
            <p class="text-xs sm:text-sm text-[#38322c] dark:text-[#ded9d0] font-normal mb-4">
              Be the first to receive publication dates, chapter previews, and private pre-order access.
            </p>

            <form
              class="space-y-3"
              onsubmit="event.preventDefault(); const email = this.querySelector('input').value; window.location.href = `mailto:anishabanerji@gmail.com?subject=${encodeURIComponent('Book Waitlist Request')}&body=${encodeURIComponent('Please add me to the book waitlist: ' + email)}`; alert('Thank you for joining the book waitlist!');"
            >
              <input
                type="email"
                required
                placeholder="Enter your email address"
                class="w-full px-4 py-2.5 rounded-md glass-input text-sm text-[#110f0d] dark:text-[#ffffff]"
              />
              <GlassButton
                text="Notify Me on Launch"
                type="submit"
                size="medium"
                width="100%"
              />
            </form>
          </div>
        </div>

        <!-- Right: Book Mockup Art -->
        <div class="md:col-span-5 lg:col-span-5 xl:col-span-4 flex justify-center">
          <div class="relative w-full max-w-sm aspect-[3/4] rounded-xl bg-gradient-to-br from-[#28231e] to-[#141312] p-8 sm:p-10 text-white shadow-2xl flex flex-col justify-between border border-[#e5c98f]/30">
            <div class="space-y-2">
              <span class="text-[10px] uppercase tracking-[0.3em] text-[#e5c98f] block">Astro by Anisha</span>
              <div class="h-px w-10 bg-[#e5c98f]/40 my-3"></div>
            </div>

            <div class="my-auto text-center py-6">
              <h3 class="font-serif text-3xl sm:text-4xl font-medium tracking-tight text-[#f5efe6] mb-3">
                The Sacred Mirror
              </h3>
              <p class="text-xs uppercase tracking-[0.2em] text-[#e5c98f]">
                Planetary Timing & Archetypes
              </p>
            </div>

            <div class="pt-4 border-t border-white/10 flex justify-between items-center text-xs tracking-wider text-[#ded9d0]">
              <span>Anisha Banerji</span>
              <span class="text-[#e5c98f]">&bull;</span>
              <span>Forthcoming</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>
