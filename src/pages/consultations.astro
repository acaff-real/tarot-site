---
import Layout from '../layouts/Layout.astro';
import GlassButton from '../components/GlassButton.astro';
import { SERVICES } from '../data/services';
---

<Layout
  title="Consultations & Advisory — Astrology by Anisha"
  description="Private 1-on-1 consultations in Vedic astrology, intuitive tarot, and sacred numerology with Anisha Sharma. Transparent pricing and booking details."
  currentPath="/consultations"
>
  <!-- Header -->
  <section class="pt-16 pb-14 lg:pt-24 lg:pb-20 bg-[#fcfbf9] border-b border-[#28231e]/10">
    <div class="max-w-4xl mx-auto px-6 sm:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold uppercase tracking-[0.2em] bg-white border border-[#28231e]/10 text-[#a37a4c] mb-4">
        <span>Private Advisory</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-[#1c1917] tracking-tight leading-tight">
        Consultation Offerings
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[#57534e] font-light max-w-2xl mx-auto leading-relaxed">
        Confidential, collaborative containers designed to bring decisive clarity to your life thresholds. Available via live high-definition video worldwide.
      </p>
    </div>
  </section>

  <!-- Detailed Service Cards -->
  <section class="py-16 lg:py-24 bg-[#faf8f5]">
    <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
        {
          SERVICES.map((s) => (
            <div class="glass-card rounded-3xl p-8 sm:p-10 border border-[#28231e]/10 bg-white/70 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-xs uppercase tracking-[0.2em] text-[#a37a4c] font-semibold">
                    {s.duration}
                  </span>
                  <span class="font-serif text-2xl font-medium text-[#1c1917]">
                    {s.investment}
                  </span>
                </div>

                <h2 class="font-serif text-3xl text-[#1c1917] font-medium leading-tight mb-2">
                  {s.title}
                </h2>
                <p class="text-xs uppercase tracking-wider text-[#857f77] mb-4 font-medium">
                  {s.subtitle}
                </p>

                <p class="text-sm text-[#57534e] font-light leading-relaxed mb-6">
                  {s.shortDesc}
                </p>

                <div class="border-t border-[#28231e]/10 pt-5 mb-8">
                  <span class="text-[11px] uppercase tracking-wider text-[#857f77] font-semibold block mb-3">
                    Session Inclusions:
                  </span>
                  <ul class="space-y-2.5 text-xs text-[#57534e]">
                    {s.deliverables.map((item) => (
                      <li class="flex items-start gap-2.5">
                        <span class="text-[#a37a4c] font-bold mt-0.5">&bull;</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="pt-2">
                <GlassButton
                  text="Request Consultation"
                  href="#booking-form"
                  size="medium"
                  width="100%"
                />
              </div>
            </div>
          ))
        }
      </div>

      <!-- What to Expect Grid -->
      <div class="rounded-3xl bg-white border border-[#28231e]/10 p-8 sm:p-12 mb-20">
        <h3 class="font-serif text-3xl text-[#1c1917] text-center mb-12">
          The Consultation Protocol
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <span class="font-serif text-3xl text-[#a37a4c] font-light block mb-2">01</span>
            <h4 class="font-semibold text-base text-[#1c1917] mb-2">Before We Meet</h4>
            <p class="text-xs sm:text-sm text-[#57534e] font-light leading-relaxed">
              Upon booking, you will provide your exact birth information and 1-3 core focus inquiries. Anisha spends 2-3 hours pre-analyzing your planetary charts and transits before opening the call.
            </p>
          </div>

          <div>
            <span class="font-serif text-3xl text-[#a37a4c] font-light block mb-2">02</span>
            <h4 class="font-semibold text-base text-[#1c1917] mb-2">During the Session</h4>
            <p class="text-xs sm:text-sm text-[#57534e] font-light leading-relaxed">
              We meet via private high-resolution video. The conversation is collaborative, compassionate, and grounded. We directly dissect timelines, relationship dynamics, and energetic blocks.
            </p>
          </div>

          <div>
            <span class="font-serif text-3xl text-[#a37a4c] font-light block mb-2">03</span>
            <h4 class="font-semibold text-base text-[#1c1917] mb-2">Aftercare & Integration</h4>
            <p class="text-xs sm:text-sm text-[#57534e] font-light leading-relaxed">
              Within 24 hours of our session, you receive the full video/audio recording along with custom remedies, gemstone/color alignments, and key calendar dates for your upcoming year.
            </p>
          </div>
        </div>
      </div>

      <!-- Booking Request Form -->
      <div id="booking-form" class="max-w-2xl mx-auto rounded-3xl glass-panel p-8 sm:p-12 border border-[#28231e]/10 shadow-xl">
        <div class="text-center mb-8">
          <span class="text-xs uppercase tracking-[0.2em] text-[#a37a4c] font-semibold block mb-1">Appointment Request</span>
          <h3 class="font-serif text-3xl text-[#1c1917]">
            Schedule Your Consultation
          </h3>
          <p class="text-xs sm:text-sm text-[#57534e] font-light mt-2">
            Please fill in your details below. You will receive a response within 24 hours to confirm calendar availability.
          </p>
        </div>

        <form class="space-y-5" onsubmit="event.preventDefault(); alert('Thank you, your consultation inquiry has been received. Anisha will contact you within 24 hours.');">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#57534e] mb-1.5">Your Name</label>
              <input type="text" required class="w-full px-4 py-3 rounded-xl glass-input text-sm" placeholder="Full name" />
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#57534e] mb-1.5">Email Address</label>
              <input type="email" required class="w-full px-4 py-3 rounded-xl glass-input text-sm" placeholder="email@domain.com" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#57534e] mb-1.5">Select Consultation</label>
            <select class="w-full px-4 py-3 rounded-xl glass-input text-sm bg-white cursor-pointer">
              <option>Vedic Astrology Consultation (75 Min &bull; $275)</option>
              <option>Intuitive Tarot Reading (50 Min &bull; $195)</option>
              <option>Sacred Numerology & Name Analysis (60 Min &bull; $225)</option>
              <option>Private Mentorship & Retainer Advisory (Inquire)</option>
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#57534e] mb-1.5">Preferred Day / Time</label>
              <input type="text" class="w-full px-4 py-3 rounded-xl glass-input text-sm" placeholder="e.g. Weekday mornings (EST)" />
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-[#57534e] mb-1.5">Location / Timezone</label>
              <input type="text" class="w-full px-4 py-3 rounded-xl glass-input text-sm" placeholder="e.g. London (GMT) / NY (EST)" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-[#57534e] mb-1.5">Primary Questions / Focus Areas</label>
            <textarea rows="4" class="w-full px-4 py-3 rounded-xl glass-input text-sm" placeholder="Share any particular transitions, decisions, or themes you wish to explore..."></textarea>
          </div>

          <div class="pt-2">
            <GlassButton
              text="Submit Consultation Request"
              type="submit"
              size="large"
              width="100%"
            />
          </div>
        </form>
      </div>

    </div>
  </section>
</Layout>
