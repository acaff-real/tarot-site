---
import Layout from '../layouts/Layout.astro';
import GlassButton from '../components/GlassButton.astro';
---

<Layout
  title="Contact — Astro by Anisha"
  description="Connect with Anisha Banerji for consultation requests, press, podcast inquiries, and general correspondence."
  currentPath="/contact"
>
  <!-- Header -->
  <section class="pt-12 pb-10 sm:pt-16 sm:pb-14 md:pt-20 md:pb-16 lg:pt-24 lg:pb-20 bg-[#fcfbf9] dark:bg-[#090716] border-b border-[#28231e]/10 dark:border-purple-500/20">
    <div class="max-w-4xl xl:max-w-6xl mx-auto px-4 sm:px-6 md:px-8 text-center">
      <span class="text-xs uppercase tracking-[0.25em] text-[#855b25] dark:text-[#e5c98f] font-semibold block mb-3">
        Direct Communication
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-[#110f0d] dark:text-[#ffffff] tracking-tight leading-tight font-medium">
        Begin a Conversation
      </h1>
      <p class="mt-4 text-base sm:text-lg md:text-xl text-[#2c2722] dark:text-[#f0ebe1] font-normal max-w-2xl xl:max-w-3xl mx-auto leading-relaxed">
        Whether you have questions regarding consultations or wish to explore a media collaboration with Anisha Banerji, we welcome your note.
      </p>
    </div>
  </section>

  <!-- Contact Form & Info Grid -->
  <section class="py-14 sm:py-18 md:py-20 lg:py-24 xl:py-28 bg-[#faf8f5] dark:bg-[#060410]">
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      <div class="grid grid-cols-1 md:grid-cols-12 lg:grid-cols-12 gap-8 md:gap-10 lg:gap-14 xl:gap-16 items-start">
        
        <!-- Info Column -->
        <div class="md:col-span-5 lg:col-span-5 xl:col-span-4 space-y-6 sm:space-y-8">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl text-[#110f0d] dark:text-[#ffffff] mb-3 font-medium">
              Office & Studio
            </h2>
            <p class="text-sm text-[#38322c] dark:text-[#ded9d0] font-normal leading-relaxed">
              Consultations are conducted digitally via private high-definition video with clients across the United Kingdom, North America, India, Europe, and Australia.
            </p>
          </div>

          <div class="space-y-4 text-xs text-[#2c2722] dark:text-[#ded9d0]">
            <div class="p-5 sm:p-6 rounded-lg bg-white/90 dark:bg-[#0f0b24]/90 border border-[#28231e]/15 dark:border-purple-500/25 shadow-xs">
              <span class="text-[#855b25] dark:text-[#e5c98f] font-semibold uppercase tracking-wider block mb-1">Direct Email</span>
              <a href="mailto:anishabanerji@gmail.com" class="text-base font-medium text-[#110f0d] dark:text-[#ffffff] hover:underline">
                anishabanerji@gmail.com
              </a>
              <p class="text-[11px] text-[#5a534b] dark:text-[#a8a29a] mt-1">Direct responses provided within 24–48 business hours.</p>
            </div>

            <div class="p-5 sm:p-6 rounded-lg bg-white/90 dark:bg-[#0f0b24]/90 border border-[#28231e]/15 dark:border-purple-500/25 shadow-xs">
              <span class="text-[#855b25] dark:text-[#e5c98f] font-semibold uppercase tracking-wider block mb-1">Social Platforms</span>
              <div class="mt-2 space-y-2 text-sm">
                <div>
                  <a href="https://www.instagram.com/tarotbyanisha/" target="_blank" rel="noopener noreferrer" class="text-[#110f0d] dark:text-[#ffffff] hover:text-[#855b25] dark:hover:text-[#e5c98f] font-medium flex items-center justify-between transition-colors">
                    <span>Instagram: @tarotbyanisha</span>
                    <span>&rarr;</span>
                  </a>
                </div>
                <div>
                  <a href="https://www.youtube.com/tarotbyanisha" target="_blank" rel="noopener noreferrer" class="text-[#38322c] dark:text-[#ded9d0] hover:text-[#110f0d] dark:hover:text-[#ffffff] flex items-center justify-between transition-colors">
                    <span>YouTube: Tarot by Anisha</span>
                    <span>&rarr;</span>
                  </a>
                </div>
                <div>
                  <a href="https://twitter.com/tarotbyanishaa" target="_blank" rel="noopener noreferrer" class="text-[#38322c] dark:text-[#ded9d0] hover:text-[#110f0d] dark:hover:text-[#ffffff] flex items-center justify-between transition-colors">
                    <span>X (Twitter): @tarotbyanishaa</span>
                    <span>&rarr;</span>
                  </a>
                </div>
                <div>
                  <a href="https://www.linkedin.com/in/tarotbyanisha/" target="_blank" rel="noopener noreferrer" class="text-[#38322c] dark:text-[#ded9d0] hover:text-[#110f0d] dark:hover:text-[#ffffff] flex items-center justify-between transition-colors">
                    <span>LinkedIn: Anisha Banerji</span>
                    <span>&rarr;</span>
                  </a>
                </div>
                <div>
                  <a href="https://www.facebook.com/Tarotbyanisha" target="_blank" rel="noopener noreferrer" class="text-[#38322c] dark:text-[#ded9d0] hover:text-[#110f0d] dark:hover:text-[#ffffff] flex items-center justify-between transition-colors">
                    <span>Facebook: Tarot by Anisha</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </div>
            </div>

            <div class="p-5 sm:p-6 rounded-lg bg-white/90 dark:bg-[#0f0b24]/90 border border-[#28231e]/15 dark:border-purple-500/25 shadow-xs">
              <span class="text-[#855b25] dark:text-[#e5c98f] font-semibold uppercase tracking-wider block mb-1">Confidentiality Guarantee</span>
              <p class="text-xs text-[#38322c] dark:text-[#ded9d0] leading-relaxed mt-1">
                Every consultation, birth chart assessment, and email correspondence is held under strict professional confidentiality.
              </p>
            </div>
          </div>
        </div>

        <!-- Form Column -->
        <div class="md:col-span-7 lg:col-span-7 xl:col-span-8">
          <div class="rounded-xl glass-panel p-6 sm:p-8 md:p-8 lg:p-10 border border-[#28231e]/15 dark:border-purple-500/25 shadow-lg bg-white/90 dark:bg-[#0f0b24]/90">
            <h3 class="font-serif text-2xl sm:text-3xl text-[#110f0d] dark:text-[#ffffff] mb-2 font-medium">
              Send an Inquiry
            </h3>
            <p class="text-sm text-[#38322c] dark:text-[#ded9d0] mb-6">
              Please share how we can support you. This will deliver directly to <span class="font-semibold text-[#110f0d] dark:text-[#ffffff]">anishabanerji@gmail.com</span>.
            </p>

            <form id="contact-form" class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider text-[#2c2722] dark:text-[#ded9d0] mb-1.5">First & Last Name</label>
                  <input type="text" id="contact-name" required class="w-full px-4 py-3 rounded-md glass-input text-sm text-[#110f0d] dark:text-[#ffffff]" placeholder="Your name" />
                </div>
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider text-[#2c2722] dark:text-[#ded9d0] mb-1.5">Email Address</label>
                  <input type="email" id="contact-email" required class="w-full px-4 py-3 rounded-md glass-input text-sm text-[#110f0d] dark:text-[#ffffff]" placeholder="email@domain.com" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-[#2c2722] dark:text-[#ded9d0] mb-1.5">Topic of Inquiry</label>
                <select id="contact-topic" class="w-full px-4 py-3 rounded-md glass-input text-sm bg-white dark:bg-[#120d2c] cursor-pointer font-medium text-[#110f0d] dark:text-[#ffffff]">
                  <option value="Consultation Booking Question">Consultation Booking Question</option>
                  <option value="Vedic Birth Chart Assessment">Vedic Birth Chart Assessment</option>
                  <option value="Numerology & Name Inquiry">Numerology & Name Inquiry</option>
                  <option value="Speaking, Media or Podcast Invitation">Speaking, Media or Podcast Invitation</option>
                  <option value="General Inquiry">General Inquiry</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-[#2c2722] dark:text-[#ded9d0] mb-1.5">Your Message</label>
                <textarea id="contact-message" rows="5" required class="w-full px-4 py-3 rounded-md glass-input text-sm text-[#110f0d] dark:text-[#ffffff]" placeholder="Please share details about your inquiry..."></textarea>
              </div>

              <div class="pt-2">
                <GlassButton
                  text="Send Message to Anisha"
                  type="submit"
                  size="large"
                  width="100%"
                />
              </div>
            </form>

            <!-- Success Box -->
            <div id="contact-success-box" class="hidden mt-6 p-6 rounded-lg bg-[#f7f4ed] dark:bg-[#120d2c] border border-[#855b25]/30 dark:border-purple-500/30 text-center space-y-4">
              <div class="w-10 h-10 rounded-md bg-[#855b25]/15 dark:bg-[#e5c98f]/20 text-[#855b25] dark:text-[#e5c98f] mx-auto flex items-center justify-center font-bold text-lg">
                &#10003;
              </div>
              <h4 class="font-serif text-2xl text-[#110f0d] dark:text-[#ffffff] font-medium">
                Opening Direct Email to Anisha
              </h4>
              <p class="text-sm text-[#38322c] dark:text-[#ded9d0] max-w-md mx-auto">
                Your message has been prepared for <strong class="text-[#110f0d] dark:text-[#ffffff]">anishabanerji@gmail.com</strong>. If your email client did not automatically launch:
              </p>
              <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
                <a
                  id="contact-gmail-btn"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-5 py-2.5 rounded-full bg-[#110f0d] text-white text-xs font-semibold uppercase tracking-wider hover:bg-[#855b25] transition-colors"
                >
                  Open in Gmail
                </a>
                <button
                  type="button"
                  id="contact-copy-btn"
                  class="px-5 py-2.5 rounded-full border border-[#28231e]/20 dark:border-purple-500/30 text-xs font-semibold uppercase tracking-wider text-[#110f0d] dark:text-[#ffffff] hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
                >
                  Copy Message
                </button>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    if (!form) return;

    const successBox = document.getElementById('contact-success-box');
    const gmailBtn = document.getElementById('contact-gmail-btn') as HTMLAnchorElement;
    const copyBtn = document.getElementById('contact-copy-btn');

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value || '';
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value || '';
      const topic = (document.getElementById('contact-topic') as HTMLSelectElement)?.value || 'General Inquiry';
      const msg = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value || '';

      const subject = `Inquiry: ${topic} — ${name}`;
      const body = `Dear Anisha,

You have received an inquiry from your website:

• Name: ${name}
• Email: ${email}
• Topic: ${topic}

Message:
${msg}

Best regards,
${name}`;

      const recipient = 'anishabanerji@gmail.com';
      const mailtoUrl = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      const gmailWebUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${recipient}&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      if (successBox) successBox.classList.remove('hidden');
      if (gmailBtn) gmailBtn.href = gmailWebUrl;

      if (copyBtn) {
        copyBtn.onclick = () => {
          navigator.clipboard.writeText(body);
          copyBtn.textContent = 'Copied to Clipboard!';
          setTimeout(() => {
            copyBtn.textContent = 'Copy Message';
          }, 3000);
        };
      }

      window.location.href = mailtoUrl;
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>
