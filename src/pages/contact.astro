---
import Layout from '../layouts/Layout.astro';
import GlassButton from '../components/GlassButton.astro';
---

<Layout
  title="Contact — Astro by Anisha"
  description="Connect with Anisha Banerji for consultation requests, press, podcast inquiries, and general correspondence."
  currentPath="/contact"
>
  <!-- Header -->
  <section class="pt-12 pb-10 sm:pt-16 sm:pb-14 md:pt-20 md:pb-16 lg:pt-24 lg:pb-20 bg-[#fcfbf9] border-b border-[#28231e]/10">
    <div class="max-w-4xl xl:max-w-5xl mx-auto px-4 sm:px-6 md:px-8 text-center">
      <span class="text-xs uppercase tracking-[0.25em] text-[#a37a4c] font-semibold block mb-3">
        Direct Communication
      </span>
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-[#1c1917] tracking-tight leading-tight">
        Begin a Conversation
      </h1>
      <p class="mt-4 text-sm sm:text-base md:text-lg text-[#57534e] font-light max-w-xl mx-auto leading-relaxed">
        Whether you have questions regarding consultations or wish to explore a media collaboration with Anisha Banerji, we welcome your note.
      </p>
    </div>
  </section>

  <!-- Contact Form & Info Grid -->
  <section class="py-14 sm:py-18 md:py-20 lg:py-24 xl:py-28 bg-[#faf8f5]">
    <div class="max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16">
      <div class="grid grid-cols-1 md:grid-cols-12 lg:grid-cols-12 gap-8 md:gap-8 lg:gap-12 items-start">
        
        <!-- Info Column -->
        <div class="md:col-span-5 lg:col-span-5 space-y-6 sm:space-y-8">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl text-[#1c1917] mb-3">
              Office & Studio
            </h2>
            <p class="text-xs sm:text-sm text-[#57534e] font-light leading-relaxed">
              Consultations are conducted digitally via private high-definition video with clients across the United Kingdom, North America, India, Europe, and Australia.
            </p>
          </div>

          <div class="space-y-4 text-xs text-[#57534e]">
            <div class="p-5 sm:p-6 rounded-lg bg-white border border-[#28231e]/10">
              <span class="text-[#a37a4c] font-semibold uppercase tracking-wider block mb-1">Direct Email</span>
              <a href="mailto:anishabanerji@gmail.com" class="text-base font-medium text-[#1c1917] hover:underline">
                anishabanerji@gmail.com
              </a>
              <p class="text-[11px] text-[#857f77] mt-1">Direct responses provided within 24–48 business hours.</p>
            </div>

            <div class="p-5 sm:p-6 rounded-lg bg-white border border-[#28231e]/10">
              <span class="text-[#a37a4c] font-semibold uppercase tracking-wider block mb-1">Social Platforms</span>
              <div class="mt-2 space-y-2 text-sm">
                <div>
                  <a href="https://instagram.com/astrobyanisha" target="_blank" rel="noopener noreferrer" class="text-[#1c1917] hover:text-[#a37a4c] font-medium flex items-center justify-between">
                    <span>Instagram: @astrobyanisha</span>
                    <span>&rarr;</span>
                  </a>
                </div>
                <div>
                  <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="text-[#57534e] hover:text-[#1c1917] flex items-center justify-between">
                    <span>YouTube: Astro by Anisha</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </div>
            </div>

            <div class="p-5 sm:p-6 rounded-lg bg-white border border-[#28231e]/10">
              <span class="text-[#a37a4c] font-semibold uppercase tracking-wider block mb-1">Confidentiality Guarantee</span>
              <p class="text-xs text-[#57534e] font-light leading-relaxed mt-1">
                Every consultation, birth chart assessment, and email correspondence is held under strict professional confidentiality.
              </p>
            </div>
          </div>
        </div>

        <!-- Form Column -->
        <div class="md:col-span-7 lg:col-span-7">
          <div class="rounded-xl glass-panel p-6 sm:p-8 md:p-8 lg:p-10 border border-[#28231e]/10 shadow-lg bg-white">
            <h3 class="font-serif text-2xl text-[#1c1917] mb-2">
              Send an Inquiry
            </h3>
            <p class="text-xs text-[#857f77] mb-6">
              Please share how we can support you. This will deliver directly to <span class="font-medium text-[#1c1917]">anishabanerji@gmail.com</span>.
            </p>

            <form id="contact-form" class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider text-[#57534e] mb-1.5">First & Last Name</label>
                  <input type="text" id="contact-name" required class="w-full px-4 py-3 rounded-md glass-input text-sm" placeholder="Your name" />
                </div>
                <div>
                  <label class="block text-xs font-semibold uppercase tracking-wider text-[#57534e] mb-1.5">Email Address</label>
                  <input type="email" id="contact-email" required class="w-full px-4 py-3 rounded-md glass-input text-sm" placeholder="email@domain.com" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-[#57534e] mb-1.5">Topic of Inquiry</label>
                <select id="contact-topic" class="w-full px-4 py-3 rounded-md glass-input text-sm bg-white cursor-pointer font-medium text-[#1c1917]">
                  <option value="Consultation Booking Question">Consultation Booking Question</option>
                  <option value="Vedic Birth Chart Assessment">Vedic Birth Chart Assessment</option>
                  <option value="Numerology & Name Inquiry">Numerology & Name Inquiry</option>
                  <option value="Speaking, Media or Podcast Invitation">Speaking, Media or Podcast Invitation</option>
                  <option value="General Inquiry">General Inquiry</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-[#57534e] mb-1.5">Your Message</label>
                <textarea id="contact-message" rows="5" required class="w-full px-4 py-3 rounded-md glass-input text-sm" placeholder="Please share details about your inquiry..."></textarea>
              </div>

              <div class="pt-2">
                <GlassButton
                  text="Send Message to Anisha"
                  type="submit"
                  size="large"
                  width="100%"
                />
              </div>
            </form>

            <!-- Success Box -->
            <div id="contact-success-box" class="hidden mt-6 p-6 rounded-lg bg-[#f7f4ed] border border-[#a37a4c]/30 text-center space-y-4">
              <div class="w-10 h-10 rounded-md bg-[#a37a4c]/10 text-[#a37a4c] mx-auto flex items-center justify-center font-bold text-lg">
                &#10003;
              </div>
              <h4 class="font-serif text-2xl text-[#1c1917]">
                Opening Direct Email to Anisha
              </h4>
              <p class="text-xs sm:text-sm text-[#57534e] font-light max-w-md mx-auto">
                Your message has been prepared for <strong class="text-[#1c1917]">anishabanerji@gmail.com</strong>. If your email client did not automatically launch:
              </p>
              <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
                <a
                  id="contact-gmail-btn"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-5 py-2.5 rounded-full bg-[#1c1917] text-white text-xs font-semibold uppercase tracking-wider hover:bg-[#a37a4c] transition-colors"
                >
                  Open in Gmail
                </a>
                <button
                  type="button"
                  id="contact-copy-btn"
                  class="px-5 py-2.5 rounded-full border border-[#28231e]/20 text-xs font-semibold uppercase tracking-wider hover:bg-black/5 transition-colors"
                >
                  Copy Message
                </button>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    if (!form) return;

    const successBox = document.getElementById('contact-success-box');
    const gmailBtn = document.getElementById('contact-gmail-btn') as HTMLAnchorElement;
    const copyBtn = document.getElementById('contact-copy-btn');

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value || '';
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value || '';
      const topic = (document.getElementById('contact-topic') as HTMLSelectElement)?.value || 'General Inquiry';
      const msg = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value || '';

      const subject = `Inquiry: ${topic} — ${name}`;
      const body = `Dear Anisha,

You have received an inquiry from your website:

• Name: ${name}
• Email: ${email}
• Topic: ${topic}

Message:
${msg}

Best regards,
${name}`;

      const recipient = 'anishabanerji@gmail.com';
      const mailtoUrl = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      const gmailWebUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${recipient}&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      if (successBox) successBox.classList.remove('hidden');
      if (gmailBtn) gmailBtn.href = gmailWebUrl;

      if (copyBtn) {
        copyBtn.onclick = () => {
          navigator.clipboard.writeText(body);
          copyBtn.textContent = 'Copied to Clipboard!';
          setTimeout(() => {
            copyBtn.textContent = 'Copy Message';
          }, 3000);
        };
      }

      window.location.href = mailtoUrl;
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>
