---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getCollection } from 'astro:content';
import { getDatabase, getEnv, createSignedToken, verifySignedToken } from '../lib/db';

export const prerender = false;

// 1. Authentication Configuration & Session Checking
const cfEnv = getEnv();
const ADMIN_USER = (cfEnv.ADMIN_USER || process.env.ADMIN_USER || 'admin').trim();
const DEFAULT_ADMIN_HASH = 'f81f684c3133388d356ba4c5ccca680aa351bd81bd211873950d0cad876ab55b'; // SHA-256 for AstroAnisha2026!
const ADMIN_PASSWORD_HASH = (cfEnv.ADMIN_PASSWORD_HASH || process.env.ADMIN_PASSWORD_HASH || DEFAULT_ADMIN_HASH).trim();
const ADMIN_PASSWORD = (cfEnv.ADMIN_PASSWORD || process.env.ADMIN_PASSWORD || '').trim();

async function hashSha256(val: string): Promise<string> {
  const buffer = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(val));
  return Array.from(new Uint8Array(buffer))
    .map((b) => b.toString(16).padStart(2, '0'))
    .join('');
}

// Check logout action
const action = Astro.url.searchParams.get('action');
if (action === 'logout') {
  Astro.cookies.delete('astro_admin_auth', { path: '/' });
  Astro.cookies.delete('journalist_auth', { path: '/' });
  return Astro.redirect('/publish', 302);
}

let loginError = '';
let isAuthenticated = false;

// Check existing session cookie
const authCookie = Astro.cookies.get('astro_admin_auth')?.value || Astro.cookies.get('journalist_auth')?.value;
if (authCookie && await verifySignedToken(authCookie)) {
  isAuthenticated = true;
}

// Handle Login Form POST
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const username = formData.get('username')?.toString().trim();
    const password = formData.get('password')?.toString();

    let isValid = false;

    if (username && password) {
      const inputHash = await hashSha256(password);
      const lowerUsername = username.toLowerCase();

      // Check Cloudflare D1 database if binding is available
      const db = getDatabase();
      if (db) {
        try {
          const user = await db
            .prepare('SELECT password_hash, role FROM users WHERE LOWER(username) = LOWER(?)')
            .bind(lowerUsername)
            .first();
          if (user && user.password_hash === inputHash) {
            isValid = true;
          }
        } catch (dbErr) {
          console.error('D1 user lookup error:', dbErr);
        }
      }

      // Fallback to environment/secret verification (Worker env or Node process.env)
      if (!isValid) {
        const isUserMatch =
          lowerUsername === ADMIN_USER.toLowerCase() ||
          lowerUsername === 'anisha' ||
          lowerUsername === 'admin';

        const isHashMatch = inputHash === ADMIN_PASSWORD_HASH;
        const isPlainMatch = ADMIN_PASSWORD && password === ADMIN_PASSWORD;

        if (isUserMatch && (isHashMatch || isPlainMatch)) {
          isValid = true;
        }
      }
    }

    if (isValid) {
      const sessionToken = await createSignedToken();
      const isHttps = Astro.url.protocol === 'https:';

      Astro.cookies.set('astro_admin_auth', sessionToken, {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        secure: isHttps,
        maxAge: 60 * 60 * 24 * 7, // 7 days
      });

      Astro.cookies.set('journalist_auth', sessionToken, {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        secure: isHttps,
        maxAge: 60 * 60 * 24 * 7,
      });

      return Astro.redirect('/publish', 302);
    } else {
      loginError = 'Invalid credentials. Please verify your username and password.';
    }
  } catch (err: any) {
    loginError = 'Error processing login request. Please try again.';
  }
}

// 2. Fetch existing articles & users from D1 if authenticated
let initialArticles: any[] = [];
let initialUsers: any[] = [];
if (isAuthenticated) {
  const db = getDatabase();
  const articlesMap = new Map<string, any>();

  if (db) {
    try {
      const dbArticles = await db.prepare('SELECT * FROM articles ORDER BY published_at DESC').all();
      if (dbArticles && dbArticles.results) {
        for (const row of dbArticles.results as any[]) {
          let tagsArray = [];
          try {
            tagsArray = typeof row.tags === 'string' ? JSON.parse(row.tags) : (row.tags || []);
          } catch {
            tagsArray = typeof row.tags === 'string' ? row.tags.split(',').map((t: string) => t.trim()) : [];
          }
          articlesMap.set(row.slug, {
            slug: row.slug,
            title: row.title,
            excerpt: row.excerpt,
            category: row.category,
            date: row.date,
            readingTime: row.reading_time,
            featuredImage: row.featured_image,
            tags: tagsArray,
            content: row.content,
          });
        }
      }
    } catch (e) {
      console.error('D1 fetch articles error in publish:', e);
    }

    try {
      const dbUsers = await db.prepare('SELECT id, username, role FROM users ORDER BY id ASC').all();
      if (dbUsers && dbUsers.results) {
        initialUsers = dbUsers.results;
      }
    } catch (e) {
      console.error('D1 fetch users error in publish:', e);
    }
  }

  if (initialUsers.length === 0) {
    initialUsers = [
      { id: 1, username: 'anisha', role: 'admin' },
      { id: 2, username: 'admin', role: 'admin' },
    ];
  }

  // Merge static markdown articles if not present in D1
  try {
    const articlesCollection = await getCollection('articles');
    for (const a of articlesCollection) {
      if (!articlesMap.has(a.id)) {
        articlesMap.set(a.id, {
          slug: a.id,
          title: a.data.title,
          excerpt: a.data.excerpt,
          category: a.data.category,
          date: a.data.date,
          readingTime: a.data.readingTime,
          featuredImage: a.data.featuredImage,
          tags: a.data.tags || [],
          content: a.body || '',
        });
      }
    }
  } catch (e) {
    // collection fallback
  }

  initialArticles = Array.from(articlesMap.values());
}

const CATEGORIES = [
  'Vedic Astrology',
  'Intuitive Tarot',
  'Numerology',
  'Editorial Insights'
];

const PRESET_IMAGES = [
  { url: '/images/studio.jpg', label: 'Editorial Studio Space' },
  { url: '/images/anisha.webp', label: 'Anisha Banerji Portrait' },
  { url: '/images/og-image.jpg', label: 'Celestial Gold Star Chart' },
  { url: '/images/tarot/card-back.webp', label: 'Tarot Deck Back' },
  { url: '/images/tarot/the-star.webp', label: 'Tarot: The Star' },
  { url: '/images/tarot/the-sun.webp', label: 'Tarot: The Sun' },
  { url: '/images/tarot/the-hermit.webp', label: 'Tarot: The Hermit' },
  { url: '/images/tarot/wheel-of-fortune.webp', label: 'Tarot: Wheel of Fortune' }
];
---

<Layout
  title={isAuthenticated ? "Editorial Studio & CMS — Astro by Anisha" : "Sign In — Author Studio"}
  description="Editorial CMS and publishing studio for Astro by Anisha."
  currentPath="/publish"
  hideNavFooter={true}
>
  <!-- Load Marked and Turndown for bidirectional Visual HTML <-> Markdown conversion -->
  {isAuthenticated && (
    <>
      <script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
      <script is:inline src="https://cdn.jsdelivr.net/npm/turndown/dist/turndown.js"></script>
    </>
  )}

  {!isAuthenticated ? (
    <section class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-radial from-[#ffffff] via-[#faf8f5] to-[#f4ede1] dark:from-[#150f33] dark:via-[#0d0922] dark:to-[#04030a]">
      <div class="max-w-md w-full space-y-8 p-8 sm:p-10 rounded-2xl bg-white/95 dark:bg-[#0f0b24]/95 border border-[#28231e]/15 dark:border-purple-500/25 shadow-2xl backdrop-blur-md">
        
        <!-- Header Emblem -->
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-[#855b25]/10 dark:bg-purple-950/60 border border-[#855b25]/25 dark:border-purple-500/30 text-[#855b25] dark:text-[#e5c98f] mb-4 shadow-xs">
            <svg class="w-8 h-8" viewBox="0 0 64 64" fill="currentColor">
              <path d="M32 5 L35.5 27.5 L59 32 L35.5 36.5 L32 59 L28.5 36.5 L5 32 L28.5 27.5 Z" />
            </svg>
          </div>
          <h1 class="font-serif text-3xl sm:text-4xl text-[#110f0d] dark:text-[#ffffff] font-medium tracking-tight">
            Author Studio
          </h1>
          <p class="text-xs uppercase tracking-[0.2em] text-[#855b25] dark:text-[#e5c98f] font-semibold mt-1">
            Astro by Anisha
          </p>
          <p class="mt-3 text-xs text-[#5a534b] dark:text-[#ded9d0] leading-relaxed">
            Sign in to access the editorial CMS, manage drafts, and publish articles.
          </p>
        </div>

        {loginError && (
          <div class="p-3.5 rounded-lg bg-red-500/10 border border-red-500/25 text-red-700 dark:text-red-400 text-xs font-medium text-center">
            {loginError}
          </div>
        )}

        <!-- Login Form -->
        <form method="POST" action="/publish" class="mt-6 space-y-5">
          <div class="space-y-1.5">
            <label for="username" class="block text-xs font-semibold text-[#110f0d] dark:text-[#ffffff]">
              Username
            </label>
            <input
              id="username"
              name="username"
              type="text"
              required
              autocomplete="username"
              placeholder="admin or anisha"
              class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25] dark:focus:ring-[#e5c98f]"
            />
          </div>

          <div class="space-y-1.5">
            <label for="password" class="block text-xs font-semibold text-[#110f0d] dark:text-[#ffffff]">
              Password
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              placeholder="••••••••••••"
              class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25] dark:focus:ring-[#e5c98f]"
            />
          </div>

          <div class="pt-2">
            <button
              type="submit"
              class="iridescent w-full py-3 rounded-lg text-xs font-semibold uppercase tracking-wider text-white shadow-md cursor-pointer text-center block"
            >
              Sign In to Studio
              <span class="drop-shadow"></span>
            </button>
          </div>
        </form>

        <!-- Footer link back to site -->
        <div class="pt-4 border-t border-[#28231e]/10 dark:border-purple-500/20 text-center flex items-center justify-between text-xs text-[#5a534b] dark:text-[#a8a29a]">
          <a href="/" class="hover:text-[#110f0d] dark:hover:text-[#ffffff] transition-colors">
            &larr; Back to Website
          </a>
          <ThemeToggle id="theme-toggle-login" />
        </div>

      </div>
    </section>
  ) : (
    <div>
      <!-- Author Studio Header -->
      <header class="sticky top-0 z-40 bg-[#fcfbf9]/90 dark:bg-[#060410]/90 backdrop-blur-md border-b border-[#28231e]/10 dark:border-purple-500/20 px-4 sm:px-6 lg:px-8 py-3.5">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
          
          <!-- Brand & Section -->
          <div class="flex items-center gap-3">
            <a href="/" class="flex items-center gap-2 group">
              <svg class="w-6 h-6 text-[#855b25] dark:text-[#e5c98f] transition-transform group-hover:rotate-45" viewBox="0 0 64 64" fill="currentColor">
                <path d="M32 5 L35.5 27.5 L59 32 L35.5 36.5 L32 59 L28.5 36.5 L5 32 L28.5 27.5 Z" />
              </svg>
              <span class="font-serif text-xl sm:text-2xl font-medium tracking-tight text-[#110f0d] dark:text-[#ffffff]">
                Astro by Anisha
              </span>
            </a>
            <span class="hidden sm:inline-block px-2.5 py-0.5 rounded text-[11px] font-semibold uppercase tracking-wider bg-[#855b25]/10 dark:bg-purple-950/60 text-[#855b25] dark:text-[#e5c98f] border border-[#855b25]/20 dark:border-purple-500/30">
              Publishing Studio (/publish)
            </span>
          </div>

          <!-- Quick Actions -->
          <div class="flex items-center gap-2 sm:gap-4">
            <button
              type="button"
              id="btn-quick-new"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold uppercase tracking-wider bg-[#855b25] hover:bg-[#6c481b] dark:bg-[#e5c98f] dark:hover:bg-[#d8b56f] text-white dark:text-[#060410] shadow-xs transition-colors cursor-pointer"
            >
              <span>+</span>
              <span>New Article</span>
            </button>

            <a
              href="/articles"
              target="_blank"
              class="hidden md:inline-flex items-center gap-1 text-xs text-[#5a534b] dark:text-[#a8a29a] hover:text-[#110f0d] dark:hover:text-[#ffffff] font-medium transition-colors"
            >
              <span>View Articles</span>
              <span>&nearr;</span>
            </a>

            <a
              href="/publish?action=logout"
              class="px-2.5 py-1.5 rounded-lg text-xs font-semibold uppercase tracking-wider text-red-600/80 hover:text-red-600 hover:bg-red-500/10 transition-colors"
              title="End editorial session"
            >
              Log Out
            </a>

            <ThemeToggle id="theme-toggle-admin" />
          </div>

        </div>
      </header>

      <!-- Main Container -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
        
        <!-- Tab Navigation Bar -->
        <div class="flex items-center gap-2 border-b border-[#28231e]/10 dark:border-purple-500/20 pb-4 mb-8 overflow-x-auto">
          <button
            type="button"
            id="tab-btn-list"
            class="tab-btn active px-4 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider transition-all cursor-pointer"
          >
            All Articles (<span id="articles-count-label">{initialArticles.length}</span>)
          </button>

          <button
            type="button"
            id="tab-btn-editor"
            class="tab-btn px-4 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider transition-all cursor-pointer flex items-center gap-2"
          >
            <span>Article Studio</span>
            <span id="tab-editor-badge" class="hidden px-2 py-0.5 rounded text-[10px] font-bold bg-[#855b25]/20 dark:bg-purple-900/60 text-[#855b25] dark:text-[#e5c98f]">EDITING</span>
          </button>

          <button
            type="button"
            id="tab-btn-drafts"
            class="tab-btn px-4 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider transition-all cursor-pointer flex items-center gap-1.5"
          >
            <span>Drafts</span>
            <span id="drafts-count-badge" class="px-1.5 py-0.2 rounded-full text-[10px] bg-[#855b25]/15 dark:bg-purple-900/50 text-[#855b25] dark:text-[#e5c98f] font-mono">0</span>
          </button>

          <button
            type="button"
            id="tab-btn-media"
            class="tab-btn px-4 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider transition-all cursor-pointer flex items-center gap-1.5"
          >
            <span>Media Library</span>
            <span id="media-count-badge" class="px-1.5 py-0.2 rounded-full text-[10px] bg-[#855b25]/15 dark:bg-purple-900/50 text-[#855b25] dark:text-[#e5c98f] font-mono">{PRESET_IMAGES.length}</span>
          </button>

          <button
            type="button"
            id="tab-btn-users"
            class="tab-btn px-4 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider transition-all cursor-pointer flex items-center gap-1.5"
          >
            <span>Team & Access</span>
            <span id="users-count-badge" class="px-1.5 py-0.2 rounded-full text-[10px] bg-[#855b25]/15 dark:bg-purple-900/50 text-[#855b25] dark:text-[#e5c98f] font-mono">{initialUsers.length}</span>
          </button>
        </div>

        <!-- Notification Toast -->
        <div
          id="admin-toast"
          class="fixed bottom-6 right-6 z-50 transform translate-y-16 opacity-0 transition-all duration-300 pointer-events-none px-4 py-3 rounded-xl shadow-xl border bg-white dark:bg-[#0f0b24] text-xs font-medium flex items-center gap-2.5"
        >
          <span id="toast-icon">✓</span>
          <span id="toast-message">Action successful</span>
        </div>

        <!-- TAB 1: ALL ARTICLES (MANAGE / LIST VIEW) -->
        <section id="view-list" class="space-y-6">
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 p-4 rounded-xl bg-white/80 dark:bg-[#0f0b24]/80 border border-[#28231e]/10 dark:border-purple-500/20 shadow-xs">
            <div class="relative flex-1 max-w-md">
              <input
                type="text"
                id="search-articles-input"
                placeholder="Search articles by title, excerpt, tag..."
                class="w-full pl-9 pr-4 py-2 rounded-lg text-xs bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25] dark:focus:ring-[#e5c98f]"
              />
              <svg class="w-4 h-4 absolute left-3 top-2.5 text-[#5a534b] dark:text-[#a8a29a]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>

            <div class="flex items-center gap-2">
              <label for="filter-category-select" class="text-xs text-[#5a534b] dark:text-[#a8a29a] font-medium hidden md:inline">
                Category:
              </label>
              <select
                id="filter-category-select"
                class="px-3 py-2 rounded-lg text-xs bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25]"
              >
                <option value="ALL">All Categories</option>
                {CATEGORIES.map((cat) => (
                  <option value={cat}>{cat}</option>
                ))}
              </select>
            </div>
          </div>

          <!-- Articles Table -->
          <div class="rounded-xl border border-[#28231e]/10 dark:border-purple-500/20 bg-white/90 dark:bg-[#0f0b24]/90 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs border-collapse">
                <thead>
                  <tr class="border-b border-[#28231e]/10 dark:border-purple-500/20 bg-[#faf8f5] dark:bg-[#0a071c] text-[#5a534b] dark:text-[#a8a29a] uppercase tracking-wider text-[10px] font-semibold">
                    <th class="py-3 px-4 sm:px-6">Article</th>
                    <th class="py-3 px-4">Category</th>
                    <th class="py-3 px-4 hidden md:table-cell">Reading Time</th>
                    <th class="py-3 px-4 hidden lg:table-cell">Date</th>
                    <th class="py-3 px-4 text-center">Status</th>
                    <th class="py-3 px-4 sm:px-6 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="articles-table-body" class="divide-y divide-[#28231e]/10 dark:divide-purple-500/15">
                  <!-- Rendered via JS -->
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- TAB 2: ARTICLE STUDIO & EDITOR -->
        <section id="view-editor" class="hidden space-y-6">
          
          <!-- Active Editing Banner -->
          <div id="edit-mode-banner" class="hidden p-3.5 rounded-xl bg-[#855b25]/10 dark:bg-purple-950/40 border border-[#855b25]/30 dark:border-purple-500/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-[#855b25] dark:text-[#e5c98f]">
                ✏️ Editing Mode:
              </span>
              <span id="edit-banner-title" class="text-xs font-semibold text-[#110f0d] dark:text-[#ffffff] truncate max-w-xs sm:max-w-md"></span>
              <span id="edit-banner-slug" class="text-[10px] font-mono px-2 py-0.5 rounded bg-black/5 dark:bg-white/10 text-[#5a534b] dark:text-[#ded9d0]"></span>
            </div>
            <button
              type="button"
              id="btn-cancel-editing"
              class="text-xs font-semibold text-red-600 dark:text-red-400 hover:underline cursor-pointer"
            >
              Cancel Edit & Create New Article
            </button>
          </div>

          <!-- Top Toolbar & Heading -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#28231e]/10 dark:border-purple-500/20">
            <div>
              <h2 id="editor-heading" class="font-serif text-2xl sm:text-3xl text-[#110f0d] dark:text-[#ffffff] font-medium tracking-tight">
                Write New Article
              </h2>
              <p class="text-xs text-[#5a534b] dark:text-[#a8a29a] mt-1">
                Compose high-contrast contemplative articles with live markdown preview.
              </p>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-save-draft"
                class="px-3.5 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider border border-[#28231e]/20 dark:border-purple-500/40 text-[#110f0d] dark:text-[#ffffff] hover:bg-[#faf8f5] dark:hover:bg-purple-950/40 transition-colors cursor-pointer"
              >
                Save Draft
              </button>

              <button
                type="button"
                id="btn-export-markdown"
                class="px-3.5 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider border border-[#855b25]/40 text-[#855b25] dark:text-[#e5c98f] hover:bg-[#855b25]/10 transition-colors cursor-pointer"
                title="Download formatted .md file"
              >
                Export .md
              </button>

              <button
                type="button"
                id="btn-publish-article"
                class="px-4 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider bg-[#855b25] hover:bg-[#6c481b] dark:bg-[#e5c98f] dark:hover:bg-[#d8b56f] text-white dark:text-[#060410] shadow-sm transition-colors cursor-pointer"
              >
                <span id="publish-btn-text">Save & Publish</span>
              </button>
            </div>
          </div>

          <!-- Metadata Fields Grid -->
          <div class="grid grid-cols-1 md:grid-cols-12 gap-5 p-5 rounded-xl bg-white/80 dark:bg-[#0f0b24]/80 border border-[#28231e]/10 dark:border-purple-500/20 shadow-xs">
            <div class="md:col-span-8 space-y-1.5">
              <label for="input-title" class="text-xs font-semibold text-[#110f0d] dark:text-[#ffffff]">
                Article Title *
              </label>
              <input
                type="text"
                id="input-title"
                placeholder="e.g. Navigating Saturn Transits with Sovereign Grace"
                required
                class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25]"
              />
            </div>

            <div class="md:col-span-4 space-y-1.5">
              <label for="input-slug" class="text-xs font-semibold text-[#110f0d] dark:text-[#ffffff]">
                URL Slug (/articles/slug)
              </label>
              <input
                type="text"
                id="input-slug"
                placeholder="auto-generated-from-title"
                class="w-full px-3.5 py-2.5 rounded-lg text-sm font-mono bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25]"
              />
            </div>

            <div class="md:col-span-12 space-y-1.5">
              <label for="input-excerpt" class="text-xs font-semibold text-[#110f0d] dark:text-[#ffffff]">
                Article Excerpt / Summary * (Appears on cards & search engines)
              </label>
              <textarea
                id="input-excerpt"
                rows="2"
                placeholder="A compelling 1-2 sentence introduction capturing the contemplative essence..."
                required
                class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25] resize-y"
              ></textarea>
            </div>

            <div class="md:col-span-4 space-y-1.5">
              <label for="input-category" class="text-xs font-semibold text-[#110f0d] dark:text-[#ffffff]">
                Category *
              </label>
              <select
                id="input-category"
                class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25]"
              >
                {CATEGORIES.map((cat) => (
                  <option value={cat}>{cat}</option>
                ))}
              </select>
            </div>

            <div class="md:col-span-4 space-y-1.5">
              <label for="input-date" class="text-xs font-semibold text-[#110f0d] dark:text-[#ffffff]">
                Published Date
              </label>
              <input
                type="text"
                id="input-date"
                placeholder="e.g. October 15, 2026"
                class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25]"
              />
            </div>

            <div class="md:col-span-4 space-y-1.5">
              <label for="input-reading-time" class="text-xs font-semibold text-[#110f0d] dark:text-[#ffffff]">
                Reading Time
              </label>
              <input
                type="text"
                id="input-reading-time"
                placeholder="Auto-calculated (e.g. 6 min read)"
                class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25]"
              />
            </div>

            <div class="md:col-span-8 space-y-1.5">
              <label for="input-featured-image" class="text-xs font-semibold text-[#110f0d] dark:text-[#ffffff]">
                Featured Image URL *
              </label>
              <div class="flex items-center gap-2">
                <input
                  type="text"
                  id="input-featured-image"
                  value="/images/studio.jpg"
                  class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25]"
                />
                <button
                  type="button"
                  id="btn-pick-media-header"
                  class="px-3 py-2.5 text-xs font-semibold uppercase tracking-wider rounded-lg border border-[#855b25]/30 text-[#855b25] dark:text-[#e5c98f] hover:bg-[#855b25]/10 whitespace-nowrap cursor-pointer"
                >
                  Choose Media
                </button>
              </div>
            </div>

            <div class="md:col-span-4 space-y-1.5">
              <label for="input-tags" class="text-xs font-semibold text-[#110f0d] dark:text-[#ffffff]">
                Tags (Comma separated)
              </label>
              <input
                type="text"
                id="input-tags"
                placeholder="Astrology, Saturn, Transit"
                class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25]"
              />
            </div>
          </div>

          <!-- Visual & Markdown Workspace -->
          <div class="rounded-xl border border-[#28231e]/10 dark:border-purple-500/20 bg-white/90 dark:bg-[#0f0b24]/90 overflow-hidden shadow-xs">
            <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-2.5 border-b border-[#28231e]/10 dark:border-purple-500/20 bg-[#faf8f5] dark:bg-[#0a071c] text-xs">
              <!-- Formatting Toolbar -->
              <div id="editor-toolbar" class="flex items-center gap-1.5 overflow-x-auto text-[11px]">
                <button type="button" id="tool-p" class="rich-tool-btn px-2.5 py-1 rounded border border-[#28231e]/15 dark:border-purple-500/25 text-xs hover:bg-[#855b25]/10 text-[#110f0d] dark:text-[#ffffff] cursor-pointer" title="Normal Paragraph (P)">P</button>
                <button type="button" id="tool-lead" class="rich-tool-btn px-2.5 py-1 rounded border border-[#28231e]/15 dark:border-purple-500/25 font-serif italic text-xs hover:bg-[#855b25]/10 text-[#110f0d] dark:text-[#ffffff] cursor-pointer" title="Editorial Lead Paragraph">¶ Lead</button>
                <button type="button" id="tool-h2" class="rich-tool-btn px-2.5 py-1 rounded border border-[#28231e]/15 dark:border-purple-500/25 font-serif font-bold text-xs hover:bg-[#855b25]/10 text-[#110f0d] dark:text-[#ffffff] cursor-pointer" title="Heading 2">H2</button>
                <button type="button" id="tool-h3" class="rich-tool-btn px-2.5 py-1 rounded border border-[#28231e]/15 dark:border-purple-500/25 font-serif font-bold text-xs hover:bg-[#855b25]/10 text-[#110f0d] dark:text-[#ffffff] cursor-pointer" title="Heading 3">H3</button>
                <div class="h-4 w-px bg-[#28231e]/15 dark:border-purple-500/25 mx-0.5"></div>
                <button type="button" id="tool-bold" class="rich-tool-btn px-2.5 py-1 rounded border border-[#28231e]/15 dark:border-purple-500/25 font-bold hover:bg-[#855b25]/10 text-[#110f0d] dark:text-[#ffffff] cursor-pointer" title="Bold (Ctrl+B)">B</button>
                <button type="button" id="tool-italic" class="rich-tool-btn px-2.5 py-1 rounded border border-[#28231e]/15 dark:border-purple-500/25 italic font-serif hover:bg-[#855b25]/10 text-[#110f0d] dark:text-[#ffffff] cursor-pointer" title="Italic (Ctrl+I)">I</button>
                <button type="button" id="tool-quote" class="rich-tool-btn px-2.5 py-1 rounded border border-[#28231e]/15 dark:border-purple-500/25 hover:bg-[#855b25]/10 text-[#110f0d] dark:text-[#ffffff] cursor-pointer" title="Editorial Quote">” Quote</button>
                <button type="button" id="tool-ul" class="rich-tool-btn px-2.5 py-1 rounded border border-[#28231e]/15 dark:border-purple-500/25 hover:bg-[#855b25]/10 text-[#110f0d] dark:text-[#ffffff] cursor-pointer" title="Bullet List">• List</button>
                <button type="button" id="tool-ol" class="rich-tool-btn px-2.5 py-1 rounded border border-[#28231e]/15 dark:border-purple-500/25 hover:bg-[#855b25]/10 text-[#110f0d] dark:text-[#ffffff] cursor-pointer" title="Numbered List">1. List</button>
                <button type="button" id="tool-link" class="rich-tool-btn px-2.5 py-1 rounded border border-[#28231e]/15 dark:border-purple-500/25 hover:bg-[#855b25]/10 text-[#110f0d] dark:text-[#ffffff] cursor-pointer" title="Insert Link">🔗 Link</button>
                <button type="button" id="tool-hr" class="rich-tool-btn px-2 py-1 rounded border border-[#28231e]/15 dark:border-purple-500/25 hover:bg-[#855b25]/10 text-[#110f0d] dark:text-[#ffffff] cursor-pointer" title="Divider">― Divider</button>
                <div class="h-4 w-px bg-[#28231e]/15 dark:border-purple-500/25 mx-0.5"></div>
                <button type="button" id="toolbar-btn-insert-image" class="px-2.5 py-1 rounded bg-[#855b25]/15 dark:bg-purple-900/40 text-[#855b25] dark:text-[#e5c98f] hover:bg-[#855b25]/25 font-semibold text-xs flex items-center gap-1 cursor-pointer" title="Pick from Media Library">
                  <span>🖼 Add Image</span>
                </button>
              </div>

              <!-- Mode Switcher -->
              <div class="flex items-center gap-1 bg-[#28231e]/5 dark:bg-white/5 p-1 rounded-lg">
                <button type="button" id="btn-mode-visual" class="mode-btn active px-3 py-1 rounded text-xs font-semibold cursor-pointer">
                  ✦ Visual (Plain English)
                </button>
                <button type="button" id="btn-mode-split" class="mode-btn px-3 py-1 rounded text-xs font-semibold cursor-pointer">
                  Side-by-Side
                </button>
                <button type="button" id="btn-mode-markdown" class="mode-btn px-3 py-1 rounded text-xs font-semibold cursor-pointer">
                  Markdown Source
                </button>
              </div>
            </div>

            <!-- Workspace Panes -->
            <div id="editor-workspace" class="grid grid-cols-1 min-h-[520px]">
              <!-- Visual WYSIWYG Pane (Default) -->
              <div id="pane-visual" class="p-6 sm:p-10 max-w-4xl mx-auto w-full min-h-[500px]">
                <div
                  id="visual-canvas"
                  contenteditable="true"
                  class="visual-canvas outline-none min-h-[460px] leading-relaxed text-[#2c2722] dark:text-[#ded9d0]"
                  data-placeholder="Start typing your article here in plain English... You can write paragraphs naturally, highlight words to bold or italicize, or click formatting buttons above."
                ></div>
              </div>

              <!-- Markdown Source Pane -->
              <div id="pane-markdown" class="hidden flex flex-col p-4 bg-[#faf8f5]/40 dark:bg-[#060410]/40">
                <textarea
                  id="input-content"
                  class="w-full h-full min-h-[480px] bg-transparent text-[#110f0d] dark:text-[#ffffff] font-mono text-sm leading-relaxed outline-none resize-none focus:ring-0 border-0"
                  placeholder="Raw markdown code..."
                ></textarea>
              </div>
            </div>

            <div class="flex items-center justify-between px-4 py-2.5 text-[11px] bg-[#faf8f5] dark:bg-[#0a071c] border-t border-[#28231e]/10 dark:border-purple-500/20 text-[#5a534b] dark:text-[#a8a29a]">
              <div class="flex items-center gap-4">
                <span>Words: <strong id="stats-words" class="text-[#110f0d] dark:text-[#ffffff]">0</strong></span>
                <span>Characters: <strong id="stats-chars" class="text-[#110f0d] dark:text-[#ffffff]">0</strong></span>
                <span>Reading: <strong id="stats-reading" class="text-[#110f0d] dark:text-[#ffffff]">0 min</strong></span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-medium">✓ Live Two-Way Sync Active</span>
                <span id="auto-save-indicator" class="text-[#855b25] dark:text-[#e5c98f]">Auto-save active</span>
              </div>
            </div>
          </div>
        </section>

        <!-- TAB 3: DRAFTS MANAGER -->
        <section id="view-drafts" class="hidden space-y-6">
          <div class="flex items-center justify-between pb-4 border-b border-[#28231e]/10 dark:border-purple-500/20">
            <div>
              <h2 class="font-serif text-2xl sm:text-3xl text-[#110f0d] dark:text-[#ffffff] font-medium tracking-tight">
                Saved Local Drafts
              </h2>
              <p class="text-xs text-[#5a534b] dark:text-[#a8a29a] mt-1">
                Browser-persisted drafts are kept safely in your session.
              </p>
            </div>
            <button
              type="button"
              id="btn-clear-all-drafts"
              class="px-3 py-1.5 rounded-lg text-xs font-semibold uppercase tracking-wider border border-red-500/30 text-red-600 dark:text-red-400 hover:bg-red-500/10 transition-colors cursor-pointer"
            >
              Clear All Drafts
            </button>
          </div>

          <div id="drafts-list-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Rendered via JS -->
          </div>
        </section>

        <!-- TAB 4: MEDIA ASSET PICKER -->
        <section id="view-media" class="hidden space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#28231e]/10 dark:border-purple-500/20">
            <div>
              <h2 class="font-serif text-2xl sm:text-3xl text-[#110f0d] dark:text-[#ffffff] font-medium tracking-tight">
                Brand Media Library
              </h2>
              <p class="text-xs text-[#5a534b] dark:text-[#a8a29a] mt-1">
                Upload images from your computer, paste web image links, or use preset brand assets. Click any action to use directly.
              </p>
            </div>
            
            <button
              type="button"
              id="btn-return-to-editor-from-media"
              class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-[#855b25] dark:bg-[#e5c98f] text-white dark:text-[#060410] cursor-pointer"
            >
              &larr; Return to Editor
            </button>
          </div>

          <!-- Add Image Box: Direct Upload or Web URL -->
          <div class="p-5 rounded-xl bg-white/90 dark:bg-[#0f0b24]/90 border border-[#28231e]/10 dark:border-purple-500/20 shadow-xs space-y-4">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-[#855b25] dark:text-[#e5c98f]">
              Add New Image to Library
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-stretch">
              <!-- Upload from Computer -->
              <div class="md:col-span-5 p-4 rounded-xl border-2 border-dashed border-[#28231e]/20 dark:border-purple-500/30 bg-[#faf8f5]/60 dark:bg-[#060410]/60 flex flex-col items-center justify-center text-center">
                <input type="file" id="media-file-input" accept="image/*" class="hidden" />
                <button
                  type="button"
                  id="btn-trigger-upload"
                  class="px-4 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider bg-white dark:bg-purple-950/60 border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] hover:bg-[#faf8f5] shadow-xs cursor-pointer"
                >
                  📁 Upload from Computer
                </button>
                <p class="text-[11px] text-[#5a534b] dark:text-[#a8a29a] mt-2">
                  Select JPG, PNG, WEBP, or SVG to add to library.
                </p>
              </div>

              <!-- Add via URL -->
              <div class="md:col-span-7 flex flex-col justify-between p-4 rounded-xl border border-[#28231e]/10 dark:border-purple-500/20 bg-[#faf8f5]/40 dark:bg-[#060410]/40 space-y-3">
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-2">
                  <div class="sm:col-span-7">
                    <label for="media-url-input" class="block text-[11px] font-medium text-[#5a534b] dark:text-[#a8a29a] mb-1">Image URL</label>
                    <input
                      type="url"
                      id="media-url-input"
                      placeholder="https://images.unsplash.com/... or /images/..."
                      class="w-full px-3 py-2 rounded-lg text-xs bg-white dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff]"
                    />
                  </div>
                  <div class="sm:col-span-5">
                    <label for="media-label-input" class="block text-[11px] font-medium text-[#5a534b] dark:text-[#a8a29a] mb-1">Label / Title</label>
                    <input
                      type="text"
                      id="media-label-input"
                      placeholder="e.g. Celestial Chart"
                      class="w-full px-3 py-2 rounded-lg text-xs bg-white dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff]"
                    />
                  </div>
                </div>
                <button
                  type="button"
                  id="btn-add-media-url"
                  class="w-full py-2 rounded-lg text-xs font-semibold uppercase tracking-wider bg-[#855b25]/15 dark:bg-purple-900/40 text-[#855b25] dark:text-[#e5c98f] hover:bg-[#855b25]/25 border border-[#855b25]/25 transition-colors cursor-pointer"
                >
                  + Add Web Image to Library
                </button>
              </div>
            </div>
          </div>

          <!-- Dynamic Media Gallery Grid -->
          <div id="media-gallery-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
            <!-- Rendered dynamically via JS -->
          </div>
        </section>

        <!-- TAB 5: TEAM & USER ACCESS MANAGEMENT -->
        <section id="view-users" class="hidden space-y-8">
          <!-- Add / Edit User Form Card -->
          <div class="p-6 rounded-2xl bg-white/95 dark:bg-[#0f0b24]/95 border border-[#28231e]/10 dark:border-purple-500/20 shadow-sm space-y-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-[#28231e]/10 dark:border-purple-500/15">
              <div>
                <h3 class="font-serif text-lg font-bold text-[#110f0d] dark:text-[#ffffff]">
                  Authorize Publishing User
                </h3>
                <p class="text-xs text-[#5a534b] dark:text-[#a8a29a]">
                  Create or update accounts with permission to log in, write, edit, and publish articles.
                </p>
              </div>
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  Cloudflare D1 Auth Active
                </span>
              </div>
            </div>

            <form id="form-manage-user" class="grid grid-cols-1 md:grid-cols-12 gap-4">
              <div class="md:col-span-4 space-y-1.5">
                <label for="input-new-username" class="text-xs font-semibold text-[#110f0d] dark:text-[#ffffff]">
                  Username *
                </label>
                <div class="relative">
                  <span class="absolute left-3 top-2.5 text-xs text-[#5a534b] dark:text-[#a8a29a]">@</span>
                  <input
                    type="text"
                    id="input-new-username"
                    required
                    placeholder="e.g. journalist_priya"
                    pattern="[a-zA-Z0-9_.-]{3,30}"
                    title="3-30 alphanumeric characters, hyphens, periods, or underscores"
                    class="w-full pl-7 pr-3.5 py-2.5 rounded-lg text-xs bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25]"
                  />
                </div>
              </div>

              <div class="md:col-span-5 space-y-1.5">
                <label for="input-new-password" class="text-xs font-semibold text-[#110f0d] dark:text-[#ffffff]">
                  Password *
                </label>
                <div class="relative">
                  <input
                    type="password"
                    id="input-new-password"
                    required
                    minlength="6"
                    placeholder="Min 6 characters (e.g. SecretPass2026!)"
                    class="w-full px-3.5 py-2.5 pr-10 rounded-lg text-xs bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25]"
                  />
                  <button
                    type="button"
                    id="btn-toggle-password-visibility"
                    class="absolute right-2.5 top-2.5 text-xs text-[#5a534b] dark:text-[#a8a29a] hover:text-[#855b25] cursor-pointer"
                    title="Show/hide password"
                  >
                    👁
                  </button>
                </div>
              </div>

              <div class="md:col-span-3 space-y-1.5">
                <label for="input-new-role" class="text-xs font-semibold text-[#110f0d] dark:text-[#ffffff]">
                  Role & Permissions
                </label>
                <select
                  id="input-new-role"
                  class="w-full px-3.5 py-2.5 rounded-lg text-xs bg-[#faf8f5] dark:bg-[#060410] border border-[#28231e]/15 dark:border-purple-500/30 text-[#110f0d] dark:text-[#ffffff] focus:outline-none focus:ring-1 focus:ring-[#855b25]"
                >
                  <option value="editor">Editor (Write, Edit & Publish)</option>
                  <option value="author">Author (Draft & Submit)</option>
                  <option value="admin">Administrator (Full Access)</option>
                </select>
              </div>

              <div class="md:col-span-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pt-2">
                <p class="text-[11px] text-[#5a534b] dark:text-[#a8a29a]">
                  Tip: Submitting an existing username securely updates their password in D1 with SHA-256 encryption.
                </p>
                <button
                  type="submit"
                  id="btn-save-user"
                  class="px-5 py-2.5 rounded-lg text-xs font-semibold uppercase tracking-wider bg-[#855b25] text-white dark:bg-[#e5c98f] dark:text-[#060410] hover:opacity-90 transition-opacity cursor-pointer shadow-xs flex items-center gap-2 whitespace-nowrap"
                >
                  <span>Save & Grant Access</span>
                </button>
              </div>
            </form>
          </div>

          <!-- Existing Authorized Users List -->
          <div class="p-6 rounded-2xl bg-white/95 dark:bg-[#0f0b24]/95 border border-[#28231e]/10 dark:border-purple-500/20 shadow-sm space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h4 class="font-serif text-base font-bold text-[#110f0d] dark:text-[#ffffff]">
                  Authorized Publishing Accounts (<span id="users-table-count">{initialUsers.length}</span>)
                </h4>
                <p class="text-xs text-[#5a534b] dark:text-[#a8a29a]">
                  Stored securely in Cloudflare D1 with active credentials.
                </p>
              </div>
              <button
                type="button"
                id="btn-refresh-users"
                class="px-3 py-1.5 text-xs text-[#855b25] dark:text-[#e5c98f] border border-[#855b25]/25 rounded-lg hover:bg-[#855b25]/10 cursor-pointer flex items-center gap-1.5"
              >
                <span>↻ Refresh</span>
              </button>
            </div>

            <div class="overflow-x-auto rounded-xl border border-[#28231e]/10 dark:border-purple-500/15">
              <table class="w-full text-left text-xs border-collapse">
                <thead>
                  <tr class="border-b border-[#28231e]/10 dark:border-purple-500/20 bg-[#faf8f5] dark:bg-[#0a071c] text-[#5a534b] dark:text-[#a8a29a] uppercase tracking-wider text-[10px] font-semibold">
                    <th class="py-3 px-4 sm:px-6">User</th>
                    <th class="py-3 px-4">Role</th>
                    <th class="py-3 px-4">Authentication</th>
                    <th class="py-3 px-4 sm:px-6 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="users-table-body" class="divide-y divide-[#28231e]/10 dark:divide-purple-500/15">
                  <!-- Rendered via JS -->
                </tbody>
              </table>
            </div>
          </div>
        </section>

      </div>

      <!-- Client-Side State Management Script -->
      <script is:inline define:vars={{ initialArticles, PRESET_IMAGES, initialUsers }}>
        let articles = Array.isArray(initialArticles) ? initialArticles : [];
        let users = Array.isArray(initialUsers) ? initialUsers : [];
        let currentEditingSlug = null;
        let autoSaveTimer = null;

        const tabBtnList = document.getElementById('tab-btn-list');
        const tabBtnEditor = document.getElementById('tab-btn-editor');
        const tabBtnDrafts = document.getElementById('tab-btn-drafts');
        const tabBtnMedia = document.getElementById('tab-btn-media');
        const tabBtnUsers = document.getElementById('tab-btn-users');
        const tabEditorBadge = document.getElementById('tab-editor-badge');

        const viewList = document.getElementById('view-list');
        const viewEditor = document.getElementById('view-editor');
        const viewDrafts = document.getElementById('view-drafts');
        const viewMedia = document.getElementById('view-media');
        const viewUsers = document.getElementById('view-users');

        const tableBody = document.getElementById('articles-table-body');
        const searchInput = document.getElementById('search-articles-input');
        const filterCategory = document.getElementById('filter-category-select');

        const editModeBanner = document.getElementById('edit-mode-banner');
        const editBannerTitle = document.getElementById('edit-banner-title');
        const editBannerSlug = document.getElementById('edit-banner-slug');
        const btnCancelEditing = document.getElementById('btn-cancel-editing');

        const inputTitle = document.getElementById('input-title');
        const inputSlug = document.getElementById('input-slug');
        const inputExcerpt = document.getElementById('input-excerpt');
        const inputCategory = document.getElementById('input-category');
        const inputDate = document.getElementById('input-date');
        const inputReadingTime = document.getElementById('input-reading-time');
        const inputFeaturedImage = document.getElementById('input-featured-image');
        const inputTags = document.getElementById('input-tags');
        const inputContent = document.getElementById('input-content');
        const visualCanvas = document.getElementById('visual-canvas');
        const paneVisual = document.getElementById('pane-visual');
        const paneMarkdown = document.getElementById('pane-markdown');
        const btnModeVisual = document.getElementById('btn-mode-visual');
        const btnModeSplit = document.getElementById('btn-mode-split');
        const btnModeMarkdown = document.getElementById('btn-mode-markdown');
        const workspace = document.getElementById('editor-workspace');
        const editorHeading = document.getElementById('editor-heading');
        const publishBtnText = document.getElementById('publish-btn-text');

        const statsWords = document.getElementById('stats-words');
        const statsChars = document.getElementById('stats-chars');
        const statsReading = document.getElementById('stats-reading');
        const draftsBadge = document.getElementById('drafts-count-badge');
        const autoSaveIndicator = document.getElementById('auto-save-indicator');

        function showToast(message, isError = false) {
          const toast = document.getElementById('admin-toast');
          const toastMsg = document.getElementById('toast-message');
          const toastIcon = document.getElementById('toast-icon');
          if (!toast || !toastMsg) return;

          toastMsg.textContent = message;
          toastIcon.textContent = isError ? '⚠' : '✓';
          toast.className = `fixed bottom-6 right-6 z-50 transition-all duration-300 px-4 py-3 rounded-xl shadow-xl border text-xs font-medium flex items-center gap-2.5 ${
            isError
              ? 'bg-red-50 dark:bg-red-950 border-red-300 dark:border-red-800 text-red-800 dark:text-red-200'
              : 'bg-[#faf8f5] dark:bg-[#0f0b24] border-[#855b25]/30 text-[#855b25] dark:text-[#e5c98f]'
          }`;

          toast.style.transform = 'translateY(0)';
          toast.style.opacity = '1';

          setTimeout(() => {
            toast.style.transform = 'translateY(4rem)';
            toast.style.opacity = '0';
          }, 3500);
        }

        function setTab(tabName) {
          [viewList, viewEditor, viewDrafts, viewMedia, viewUsers].forEach((v) => v?.classList.add('hidden'));
          [tabBtnList, tabBtnEditor, tabBtnDrafts, tabBtnMedia, tabBtnUsers].forEach((b) => {
            b?.classList.remove('bg-[#855b25]', 'text-white', 'dark:bg-[#e5c98f]', 'dark:text-[#060410]');
            b?.classList.add('text-[#5a534b]', 'dark:text-[#a8a29a]');
          });

          if (tabName === 'list' && viewList) {
            viewList.classList.remove('hidden');
            tabBtnList?.classList.add('bg-[#855b25]', 'text-white', 'dark:bg-[#e5c98f]', 'dark:text-[#060410]');
          } else if (tabName === 'editor' && viewEditor) {
            viewEditor.classList.remove('hidden');
            tabBtnEditor?.classList.add('bg-[#855b25]', 'text-white', 'dark:bg-[#e5c98f]', 'dark:text-[#060410]');
          } else if (tabName === 'drafts' && viewDrafts) {
            viewDrafts.classList.remove('hidden');
            tabBtnDrafts?.classList.add('bg-[#855b25]', 'text-white', 'dark:bg-[#e5c98f]', 'dark:text-[#060410]');
            renderDrafts();
          } else if (tabName === 'media' && viewMedia) {
            viewMedia.classList.remove('hidden');
            tabBtnMedia?.classList.add('bg-[#855b25]', 'text-white', 'dark:bg-[#e5c98f]', 'dark:text-[#060410]');
            renderMediaGallery();
          } else if (tabName === 'users' && viewUsers) {
            viewUsers.classList.remove('hidden');
            tabBtnUsers?.classList.add('bg-[#855b25]', 'text-white', 'dark:bg-[#e5c98f]', 'dark:text-[#060410]');
            renderUsersTable();
          }
        }

        tabBtnList?.addEventListener('click', () => setTab('list'));
        tabBtnEditor?.addEventListener('click', () => setTab('editor'));
        tabBtnDrafts?.addEventListener('click', () => setTab('drafts'));
        tabBtnMedia?.addEventListener('click', () => setTab('media'));
        tabBtnUsers?.addEventListener('click', () => setTab('users'));
        document.getElementById('btn-quick-new')?.addEventListener('click', () => {
          resetEditor();
          setTab('editor');
        });
        document.getElementById('btn-return-to-editor-from-media')?.addEventListener('click', () => {
          setTab('editor');
        });

        // ----------------------------------------------------
        // EDITING & ARTICLES TABLE
        // ----------------------------------------------------
        function renderArticlesTable() {
          if (!tableBody) return;
          const query = (searchInput?.value || '').toLowerCase().trim();
          const cat = filterCategory?.value || 'ALL';

          const filtered = articles.filter((a) => {
            const matchesQuery =
              !query ||
              (a.title || '').toLowerCase().includes(query) ||
              (a.excerpt || '').toLowerCase().includes(query) ||
              (a.tags && a.tags.some((t) => (t || '').toLowerCase().includes(query)));
            const matchesCat = cat === 'ALL' || a.category === cat;
            return matchesQuery && matchesCat;
          });

          if (filtered.length === 0) {
            tableBody.innerHTML = `
              <tr>
                <td colspan="6" class="py-12 text-center text-xs text-[#5a534b] dark:text-[#a8a29a]">
                  No articles match your search or filter.
                </td>
              </tr>
            `;
            return;
          }

          tableBody.innerHTML = filtered
            .map(
              (art) => `
            <tr class="hover:bg-[#faf8f5] dark:hover:bg-purple-950/20 transition-colors">
              <td class="py-3.5 px-4 sm:px-6">
                <span class="font-serif text-sm font-semibold text-[#110f0d] dark:text-[#ffffff] block leading-snug">
                  ${art.title}
                </span>
                <span class="text-[11px] text-[#5a534b] dark:text-[#a8a29a] line-clamp-1 mt-0.5 font-light">
                  ${art.excerpt || 'No summary'}
                </span>
                <span class="text-[10px] font-mono text-[#855b25] dark:text-[#e5c98f] block mt-0.5">
                  /articles/${art.slug}
                </span>
              </td>
              <td class="py-3.5 px-4 whitespace-nowrap">
                <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-[#855b25]/10 dark:bg-purple-950/60 text-[#855b25] dark:text-[#e5c98f] border border-[#855b25]/20 dark:border-purple-500/30">
                  ${art.category || 'Vedic Astrology'}
                </span>
              </td>
              <td class="py-3.5 px-4 hidden md:table-cell whitespace-nowrap text-[#5a534b] dark:text-[#ded9d0]">
                ${art.readingTime || '5 min read'}
              </td>
              <td class="py-3.5 px-4 hidden lg:table-cell whitespace-nowrap text-[#5a534b] dark:text-[#ded9d0]">
                ${art.date || ''}
              </td>
              <td class="py-3.5 px-4 text-center whitespace-nowrap">
                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
                  Published
                </span>
              </td>
              <td class="py-3.5 px-4 sm:px-6 text-right whitespace-nowrap space-x-2">
                <button
                  type="button"
                  class="btn-table-edit px-2 py-1 rounded text-xs font-semibold bg-[#855b25]/10 text-[#855b25] dark:bg-purple-950/60 dark:text-[#e5c98f] hover:bg-[#855b25] hover:text-white dark:hover:bg-[#e5c98f] dark:hover:text-[#060410] transition-colors cursor-pointer"
                  data-slug="${art.slug}"
                >
                  Edit Article
                </button>
                <a
                  href="/articles/${art.slug}"
                  target="_blank"
                  class="text-xs text-[#5a534b] dark:text-[#a8a29a] hover:text-[#110f0d] dark:hover:text-[#ffffff] transition-colors"
                >
                  View &nearr;
                </a>
                <button
                  type="button"
                  class="btn-table-delete text-xs text-red-600/70 hover:text-red-600 transition-colors cursor-pointer"
                  data-slug="${art.slug}"
                >
                  Delete
                </button>
              </td>
            </tr>
          `
            )
            .join('');

          document.querySelectorAll('.btn-table-edit').forEach((btn) => {
            btn.addEventListener('click', () => {
              const slug = btn.getAttribute('data-slug');
              editArticle(slug);
            });
          });

          document.querySelectorAll('.btn-table-delete').forEach((btn) => {
            btn.addEventListener('click', async () => {
              const slug = btn.getAttribute('data-slug');
              if (confirm(`Are you sure you want to delete article "${slug}"?`)) {
                await deleteArticle(slug);
              }
            });
          });
        }

        searchInput?.addEventListener('input', renderArticlesTable);
        filterCategory?.addEventListener('change', renderArticlesTable);

        // ----------------------------------------------------
        // VISUAL & MARKDOWN CONVERSION ENGINES
        // ----------------------------------------------------
        let turndownService = null;
        try {
          if (typeof TurndownService !== 'undefined') {
            turndownService = new TurndownService({
              headingStyle: 'atx',
              hr: '---',
              bulletListMarker: '-',
              codeBlockStyle: 'fenced',
              emDelimiter: '*',
              strongDelimiter: '**',
            });

            // Clean paragraph rule that preserves lead class if present
            turndownService.addRule('paragraph', {
              filter: 'p',
              replacement: function (content, node) {
                if (!content.trim() && !node.querySelector('img')) return '';
                if (node.classList && node.classList.contains('lead')) {
                  return '\n\n<p class="lead">' + content + '</p>\n\n';
                }
                return '\n\n' + content + '\n\n';
              },
            });

            // Convert contenteditable div lines cleanly
            turndownService.addRule('editableDiv', {
              filter: function (node) {
                return (
                  node.nodeName === 'DIV' &&
                  !node.classList.contains('visual-canvas') &&
                  !node.querySelector('h1, h2, h3, h4, blockquote, ul, ol')
                );
              },
              replacement: function (content, node) {
                if (!content.trim() && !node.querySelector('img')) return '';
                return '\n\n' + content + '\n\n';
              },
            });

            // Blockquote rule
            turndownService.addRule('blockquote', {
              filter: 'blockquote',
              replacement: function (content) {
                content = content.trim().replace(/^/gm, '> ');
                return '\n\n' + content + '\n\n';
              },
            });

            // Image rule
            turndownService.addRule('image', {
              filter: 'img',
              replacement: function (content, node) {
                const alt = node.getAttribute('alt') || 'Image';
                const src = node.getAttribute('src') || '';
                return '\n\n![' + alt + '](' + src + ')\n\n';
              },
            });
          }
        } catch (e) {
          console.warn('TurndownService initialization warning:', e);
        }

        function simpleHtmlToMarkdown(html) {
          if (!html) return '';
          let md = html
            .replace(/<h1[^>]*>(.*?)<\/h1>/gi, '# $1\n\n')
            .replace(/<h2[^>]*>(.*?)<\/h2>/gi, '## $1\n\n')
            .replace(/<h3[^>]*>(.*?)<\/h3>/gi, '### $1\n\n')
            .replace(/<p[^>]*class="[^"]*lead[^"]*"[^>]*>(.*?)<\/p>/gi, '<p class="lead">$1</p>\n\n')
            .replace(/<strong[^>]*>(.*?)<\/strong>/gi, '**$1**')
            .replace(/<b[^>]*>(.*?)<\/b>/gi, '**$1**')
            .replace(/<em[^>]*>(.*?)<\/em>/gi, '*$1*')
            .replace(/<i[^>]*>(.*?)<\/i>/gi, '*$1*')
            .replace(/<blockquote[^>]*>(.*?)<\/blockquote>/gi, '> $1\n\n')
            .replace(/<li[^>]*>(.*?)<\/li>/gi, '- $1\n')
            .replace(/<ul[^>]*>(.*?)<\/ul>/gi, '$1\n')
            .replace(/<ol[^>]*>(.*?)<\/ol>/gi, '$1\n')
            .replace(/<a[^>]*href="([^"]*)"[^>]*>(.*?)<\/a>/gi, '[$2]($1)')
            .replace(/<img[^>]*src="([^"]*)"[^>]*alt="([^"]*)"[^>]*>/gi, '![$2]($1)\n\n')
            .replace(/<p[^>]*>(.*?)<\/p>/gi, '$1\n\n')
            .replace(/<br\s*[\/]?>/gi, '\n')
            .replace(/&nbsp;/gi, ' ');
          return md.replace(/\n{3,}/g, '\n\n').trim();
        }

        function htmlToMarkdown(html) {
          if (!html || html === '<p><br></p>' || html.trim() === '') return '';
          try {
            if (turndownService) {
              const res = turndownService.turndown(html);
              return res.replace(/\n{3,}/g, '\n\n').trim();
            }
          } catch (e) {
            console.warn('Turndown error, using fallback:', e);
          }
          return simpleHtmlToMarkdown(html);
        }

        function markdownToHtml(md) {
          if (!md || !md.trim()) return '';
          try {
            if (typeof marked !== 'undefined') {
              return marked.parse(md, {
                gfm: true,
                breaks: false,
              });
            }
          } catch (e) {
            console.warn('Marked parse error:', e);
          }
          return md;
        }

        // ----------------------------------------------------
        // BIDIRECTIONAL REAL-TIME SYNCHRONIZATION
        // ----------------------------------------------------
        let isSyncing = false;

        function updateStats(text) {
          const content = text || '';
          const words = content.trim() ? content.trim().split(/\s+/).filter(Boolean).length : 0;
          const chars = content.length;
          const readMinutes = Math.max(1, Math.ceil(words / 200));

          if (statsWords) statsWords.textContent = words.toLocaleString();
          if (statsChars) statsChars.textContent = chars.toLocaleString();
          if (statsReading) statsReading.textContent = `${readMinutes} min`;
          if (!inputReadingTime.value || !currentEditingSlug) {
            inputReadingTime.placeholder = `${readMinutes} min read`;
          }
        }

        function syncFromVisualToMarkdown() {
          if (isSyncing || !visualCanvas || !inputContent) return;
          isSyncing = true;
          const md = htmlToMarkdown(visualCanvas.innerHTML);
          inputContent.value = md;
          updateStats(visualCanvas.innerText || visualCanvas.textContent || '');
          triggerAutoSave();
          isSyncing = false;
        }

        function syncFromMarkdownToVisual() {
          if (isSyncing || !visualCanvas || !inputContent) return;
          isSyncing = true;
          const html = markdownToHtml(inputContent.value);
          visualCanvas.innerHTML = html;
          updateStats(inputContent.value);
          triggerAutoSave();
          isSyncing = false;
        }

        visualCanvas?.addEventListener('input', syncFromVisualToMarkdown);
        inputContent?.addEventListener('input', syncFromMarkdownToVisual);

        // ----------------------------------------------------
        // VISUAL FORMATTING ACTIONS
        // ----------------------------------------------------
        function execFormat(command, value = null) {
          if (currentEditorMode === 'markdown') {
            const syntaxMap = {
              'bold': '**|**',
              'italic': '*|*',
              'h2': '## |',
              'h3': '### |',
              'p': '\n\n|',
              'lead': '<p class="lead">|</p>',
              'quote': '> |',
              'ul': '- |',
              'ol': '1. |',
              'hr': '---\n',
              'link': '[Link Text](|https://)',
            };
            const mdSyntax = syntaxMap[command];
            if (mdSyntax && inputContent) {
              const start = inputContent.selectionStart;
              const end = inputContent.selectionEnd;
              const selected = inputContent.value.substring(start, end);
              const rep = mdSyntax.includes('|')
                ? mdSyntax.split('|')[0] + (selected || 'text') + mdSyntax.split('|')[1]
                : mdSyntax;
              inputContent.setRangeText(rep, start, end, 'select');
              inputContent.focus();
              syncFromMarkdownToVisual();
            }
            return;
          }

          if (!visualCanvas) return;
          visualCanvas.focus();

          function applyFormatBlock(tagName) {
            const clean = tagName.replace(/[<>]/g, '');
            let ok = false;
            try {
              ok = document.execCommand('formatBlock', false, `<${clean}>`);
            } catch (e) {}
            if (!ok) {
              try {
                ok = document.execCommand('formatBlock', false, clean);
              } catch (e) {}
            }
            return ok;
          }

          if (command === 'p') {
            applyFormatBlock('p');
          } else if (command === 'lead') {
            const sel = window.getSelection();
            if (sel && sel.anchorNode) {
              let node = sel.anchorNode.nodeType === 3 ? sel.anchorNode.parentNode : sel.anchorNode;
              while (node && node !== visualCanvas && node.nodeName !== 'P') {
                node = node.parentNode;
              }
              if (node && node.nodeName === 'P') {
                node.classList.toggle('lead');
              } else {
                applyFormatBlock('p');
                const newSel = window.getSelection();
                let pNode = newSel?.anchorNode?.nodeType === 3 ? newSel.anchorNode.parentNode : newSel?.anchorNode;
                if (pNode && pNode.nodeName === 'P') pNode.classList.add('lead');
              }
            }
          } else if (command === 'h2') {
            applyFormatBlock('h2');
          } else if (command === 'h3') {
            applyFormatBlock('h3');
          } else if (command === 'quote') {
            applyFormatBlock('blockquote');
          } else if (command === 'link') {
            const url = prompt('Enter link URL (e.g. https://...):');
            if (url) document.execCommand('createLink', false, url);
          } else if (command === 'ul') {
            document.execCommand('insertUnorderedList', false, null);
          } else if (command === 'ol') {
            document.execCommand('insertOrderedList', false, null);
          } else if (command === 'hr') {
            document.execCommand('insertHorizontalRule', false, null);
          } else {
            document.execCommand(command, false, value);
          }
          syncFromVisualToMarkdown();
        }

        document.getElementById('tool-p')?.addEventListener('click', () => execFormat('p'));
        document.getElementById('tool-lead')?.addEventListener('click', () => execFormat('lead'));
        document.getElementById('tool-h2')?.addEventListener('click', () => execFormat('h2'));
        document.getElementById('tool-h3')?.addEventListener('click', () => execFormat('h3'));
        document.getElementById('tool-bold')?.addEventListener('click', () => execFormat('bold'));
        document.getElementById('tool-italic')?.addEventListener('click', () => execFormat('italic'));
        document.getElementById('tool-quote')?.addEventListener('click', () => execFormat('quote'));
        document.getElementById('tool-ul')?.addEventListener('click', () => execFormat('ul'));
        document.getElementById('tool-ol')?.addEventListener('click', () => execFormat('ol'));
        document.getElementById('tool-hr')?.addEventListener('click', () => execFormat('hr'));
        document.getElementById('tool-link')?.addEventListener('click', () => execFormat('link'));

        // Insert Image Toolbar Button
        document.getElementById('toolbar-btn-insert-image')?.addEventListener('click', () => {
          setTab('media');
          showToast('Select an image from the library or upload one, then click "Insert into Article".');
        });

        // ----------------------------------------------------
        // WORKSPACE MODE SWITCHER (VISUAL / SPLIT / MARKDOWN)
        // ----------------------------------------------------
        let currentEditorMode = 'visual';

        function setEditorMode(mode) {
          currentEditorMode = mode;
          [btnModeVisual, btnModeSplit, btnModeMarkdown].forEach((b) => {
            b?.classList.remove('bg-white', 'dark:bg-purple-950', 'shadow-xs', 'text-[#110f0d]', 'dark:text-[#ffffff]');
            b?.classList.add('text-[#5a534b]', 'dark:text-[#a8a29a]');
          });

          if (mode === 'visual' && workspace && paneVisual && paneMarkdown) {
            btnModeVisual?.classList.add('bg-white', 'dark:bg-purple-950', 'shadow-xs', 'text-[#110f0d]', 'dark:text-[#ffffff]');
            workspace.className = 'grid grid-cols-1 min-h-[520px]';
            paneVisual.classList.remove('hidden');
            paneMarkdown.classList.add('hidden');
          } else if (mode === 'split' && workspace && paneVisual && paneMarkdown) {
            btnModeSplit?.classList.add('bg-white', 'dark:bg-purple-950', 'shadow-xs', 'text-[#110f0d]', 'dark:text-[#ffffff]');
            workspace.className = 'grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-[#28231e]/10 dark:divide-purple-500/20 min-h-[520px]';
            paneVisual.classList.remove('hidden');
            paneMarkdown.classList.remove('hidden');
          } else if (mode === 'markdown' && workspace && paneVisual && paneMarkdown) {
            btnModeMarkdown?.classList.add('bg-white', 'dark:bg-purple-950', 'shadow-xs', 'text-[#110f0d]', 'dark:text-[#ffffff]');
            workspace.className = 'grid grid-cols-1 min-h-[520px]';
            paneVisual.classList.add('hidden');
            paneMarkdown.classList.remove('hidden');
          }
        }

        btnModeVisual?.addEventListener('click', () => setEditorMode('visual'));
        btnModeSplit?.addEventListener('click', () => setEditorMode('split'));
        btnModeMarkdown?.addEventListener('click', () => setEditorMode('markdown'));

        function editArticle(slug) {
          const art = articles.find((a) => a.slug === slug);
          if (!art) return;

          currentEditingSlug = slug;
          if (editorHeading) editorHeading.textContent = `Edit: ${art.title}`;
          if (publishBtnText) publishBtnText.textContent = 'Update & Publish Article';
          if (tabEditorBadge) tabEditorBadge.classList.remove('hidden');

          if (editModeBanner) {
            editModeBanner.classList.remove('hidden');
            if (editBannerTitle) editBannerTitle.textContent = art.title;
            if (editBannerSlug) editBannerSlug.textContent = `/articles/${art.slug}`;
          }

          inputTitle.value = art.title || '';
          inputSlug.value = art.slug || '';
          inputExcerpt.value = art.excerpt || '';
          inputCategory.value = art.category || 'Vedic Astrology';
          inputDate.value = art.date || '';
          inputReadingTime.value = art.readingTime || '';
          inputFeaturedImage.value = art.featuredImage || '/images/studio.jpg';
          inputTags.value = Array.isArray(art.tags) ? art.tags.join(', ') : (art.tags || '');
          inputContent.value = art.content || '';

          if (visualCanvas) {
            visualCanvas.innerHTML = markdownToHtml(art.content || '');
          }
          updateStats(visualCanvas?.innerText || art.content || '');
          setEditorMode('visual');
          setTab('editor');
          showToast(`Loaded "${art.title}" into Visual Editor.`);
        }

        function resetEditor() {
          currentEditingSlug = null;
          if (editorHeading) editorHeading.textContent = 'Write New Article';
          if (publishBtnText) publishBtnText.textContent = 'Save & Publish';
          if (tabEditorBadge) tabEditorBadge.classList.add('hidden');
          if (editModeBanner) editModeBanner.classList.add('hidden');

          inputTitle.value = '';
          inputSlug.value = '';
          inputExcerpt.value = '';
          inputCategory.value = 'Vedic Astrology';
          inputDate.value = new Date().toLocaleDateString('en-US', { month: 'long', day: '2-digit', year: 'numeric' });
          inputReadingTime.value = '';
          inputFeaturedImage.value = '/images/studio.jpg';
          inputTags.value = '';
          inputContent.value = '';

          if (visualCanvas) {
            visualCanvas.innerHTML = '';
          }
          updateStats('');
          setEditorMode('visual');
        }

        btnCancelEditing?.addEventListener('click', () => {
          resetEditor();
          showToast('Cancelled editing. Ready for new article.');
        });

        inputTitle?.addEventListener('input', () => {
          if (!currentEditingSlug) {
            inputSlug.value = inputTitle.value
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/(^-|-$)+/g, '');
          }
          triggerAutoSave();
        });

        [inputExcerpt, inputCategory, inputDate, inputFeaturedImage, inputTags].forEach((inp) => {
          inp?.addEventListener('input', triggerAutoSave);
        });

        function triggerAutoSave() {
          clearTimeout(autoSaveTimer);
          if (autoSaveIndicator) autoSaveIndicator.textContent = 'Saving draft...';

          autoSaveTimer = setTimeout(() => {
            saveDraftLocally();
          }, 1500);
        }

        function getLocalDrafts() {
          try {
            return JSON.parse(localStorage.getItem('astro_article_drafts') || '[]');
          } catch (e) {
            return [];
          }
        }

        function saveDraftLocally() {
          if (currentEditorMode === 'visual' && visualCanvas) {
            inputContent.value = htmlToMarkdown(visualCanvas.innerHTML);
          }
          if (!inputTitle.value && !inputContent.value) return;

          const draft = {
            id: currentEditingSlug || `draft-${Date.now()}`,
            title: inputTitle.value || 'Untitled Draft',
            slug: inputSlug.value,
            excerpt: inputExcerpt.value,
            category: inputCategory.value,
            date: inputDate.value,
            readingTime: inputReadingTime.value,
            featuredImage: inputFeaturedImage.value,
            tags: inputTags.value,
            content: inputContent.value,
            savedAt: new Date().toLocaleTimeString(),
          };

          const drafts = getLocalDrafts().filter((d) => d.id !== draft.id);
          drafts.unshift(draft);
          localStorage.setItem('astro_article_drafts', JSON.stringify(drafts.slice(0, 20)));

          if (autoSaveIndicator) autoSaveIndicator.textContent = `Draft saved ${draft.savedAt}`;
          updateDraftsBadge();
        }

        function updateDraftsBadge() {
          const count = getLocalDrafts().length;
          if (draftsBadge) draftsBadge.textContent = count;
        }

        function renderDrafts() {
          const container = document.getElementById('drafts-list-container');
          if (!container) return;

          const drafts = getLocalDrafts();
          if (drafts.length === 0) {
            container.innerHTML = `
              <div class="col-span-2 py-12 text-center text-xs text-[#5a534b] dark:text-[#a8a29a]">
                No saved drafts in this browser.
              </div>
            `;
            return;
          }

          container.innerHTML = drafts
            .map(
              (d) => `
            <div class="p-4 rounded-xl border border-[#28231e]/10 dark:border-purple-500/20 bg-white/90 dark:bg-[#0f0b24]/90 space-y-2 shadow-xs">
              <div class="flex items-center justify-between">
                <span class="font-serif text-base font-semibold text-[#110f0d] dark:text-[#ffffff] truncate">
                  ${d.title}
                </span>
                <span class="text-[10px] font-mono text-[#855b25] dark:text-[#e5c98f]">
                  ${d.savedAt}
                </span>
              </div>
              <p class="text-xs text-[#5a534b] dark:text-[#a8a29a] line-clamp-2">
                ${d.excerpt || d.content.substring(0, 100) || 'No excerpt'}
              </p>
              <div class="flex items-center gap-3 pt-2 border-t border-[#28231e]/10 dark:border-purple-500/15">
                <button
                  type="button"
                  class="btn-resume-draft text-xs font-semibold text-[#855b25] dark:text-[#e5c98f] hover:underline cursor-pointer"
                  data-id="${d.id}"
                >
                  Resume Editing &rarr;
                </button>
                <button
                  type="button"
                  class="btn-delete-draft text-xs text-red-600/70 hover:text-red-600 cursor-pointer"
                  data-id="${d.id}"
                >
                  Delete
                </button>
              </div>
            </div>
          `
            )
            .join('');

          container.querySelectorAll('.btn-resume-draft').forEach((btn) => {
            btn.addEventListener('click', () => {
              const id = btn.getAttribute('data-id');
              const draft = drafts.find((d) => d.id === id);
              if (draft) {
                currentEditingSlug = draft.id.startsWith('draft-') ? null : draft.id;
                inputTitle.value = draft.title || '';
                inputSlug.value = draft.slug || '';
                inputExcerpt.value = draft.excerpt || '';
                inputCategory.value = draft.category || 'Vedic Astrology';
                inputDate.value = draft.date || '';
                inputReadingTime.value = draft.readingTime || '';
                inputFeaturedImage.value = draft.featuredImage || '/images/studio.jpg';
                inputTags.value = draft.tags || '';
                inputContent.value = draft.content || '';
                if (visualCanvas) {
                  visualCanvas.innerHTML = markdownToHtml(draft.content || '');
                }
                updateStats(visualCanvas?.innerText || draft.content || '');
                setEditorMode('visual');
                setTab('editor');
              }
            });
          });

          container.querySelectorAll('.btn-delete-draft').forEach((btn) => {
            btn.addEventListener('click', () => {
              const id = btn.getAttribute('data-id');
              const updated = drafts.filter((d) => d.id !== id);
              localStorage.setItem('astro_article_drafts', JSON.stringify(updated));
              renderDrafts();
              updateDraftsBadge();
            });
          });
        }

        document.getElementById('btn-clear-all-drafts')?.addEventListener('click', () => {
          if (confirm('Clear all local browser drafts?')) {
            localStorage.removeItem('astro_article_drafts');
            renderDrafts();
            updateDraftsBadge();
          }
        });

        document.getElementById('btn-save-draft')?.addEventListener('click', () => {
          saveDraftLocally();
          showToast('Draft saved successfully to local browser state');
        });

        function downloadMarkdownFile(art) {
          const tagsArray = Array.isArray(art.tags)
            ? art.tags
            : (art.tags || '').split(',').map((t) => t.trim()).filter(Boolean);
          const tagsYaml = tagsArray.map((t) => `  - "${t.replace(/"/g, '\\"')}"`).join('\n');

          const fileContent = `---
title: "${(art.title || '').replace(/"/g, '\\"')}"
excerpt: "${(art.excerpt || '').replace(/"/g, '\\"')}"
category: "${art.category || 'Vedic Astrology'}"
date: "${art.date || ''}"
readingTime: "${art.readingTime || '5 min read'}"
featuredImage: "${art.featuredImage || '/images/studio.jpg'}"
tags:
${tagsYaml || '  - "Astrology"'}
---

${(art.content || '').trim()}
`;

          const blob = new Blob([fileContent], { type: 'text/markdown;charset=utf-8' });
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = `${art.slug || 'article'}.md`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          showToast(`Exported ${a.download}`);
        }

        document.getElementById('btn-export-markdown')?.addEventListener('click', () => {
          if (currentEditorMode === 'visual' && visualCanvas) {
            inputContent.value = htmlToMarkdown(visualCanvas.innerHTML);
          }
          const art = {
            title: inputTitle.value || 'Untitled',
            slug: inputSlug.value || 'untitled',
            excerpt: inputExcerpt.value,
            category: inputCategory.value,
            date: inputDate.value,
            readingTime: inputReadingTime.value || statsReading?.textContent || '5 min read',
            featuredImage: inputFeaturedImage.value,
            tags: inputTags.value,
            content: inputContent.value,
          };
          downloadMarkdownFile(art);
        });

        // ----------------------------------------------------
        // PUBLISH / UPDATE HANDLER
        // ----------------------------------------------------
        document.getElementById('btn-publish-article')?.addEventListener('click', async () => {
          if (currentEditorMode === 'visual' && visualCanvas) {
            inputContent.value = htmlToMarkdown(visualCanvas.innerHTML);
          }
          const title = inputTitle.value.trim();
          if (!title) {
            alert('Please enter an article title');
            inputTitle.focus();
            return;
          }

          const originalSlug = currentEditingSlug;
          const payload = {
            slug: inputSlug.value.trim() || originalSlug,
            title,
            excerpt: inputExcerpt.value.trim(),
            category: inputCategory.value,
            date: inputDate.value.trim(),
            readingTime: inputReadingTime.value.trim() || statsReading?.textContent || '5 min read',
            featuredImage: inputFeaturedImage.value.trim() || '/images/studio.jpg',
            tags: inputTags.value,
            content: inputContent.value,
          };

          try {
            const btn = document.getElementById('btn-publish-article');
            if (btn) btn.setAttribute('disabled', 'true');
            if (publishBtnText) publishBtnText.textContent = 'Publishing to D1...';

            const res = await fetch('/api/articles', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            const data = await res.json();
            if (res.ok && data.success) {
              const savedSlug = data.slug || payload.slug;
              showToast(originalSlug ? `Updated article "${title}" successfully!` : `Published "${title}" successfully!`);

              const existingIdx = articles.findIndex((a) => a.slug === (originalSlug || savedSlug));
              const updatedItem = { ...payload, slug: savedSlug };
              if (existingIdx >= 0) {
                articles[existingIdx] = updatedItem;
              } else {
                articles.unshift(updatedItem);
              }

              const countEl = document.getElementById('articles-count-label');
              if (countEl) countEl.textContent = articles.length;
              renderArticlesTable();
              resetEditor();
              setTab('list');
            } else {
              showToast(data.error || 'Server error saving article.', true);
            }
          } catch (err) {
            showToast('Network error while saving article.', true);
          } finally {
            const btn = document.getElementById('btn-publish-article');
            if (btn) btn.removeAttribute('disabled');
            if (publishBtnText) {
              publishBtnText.textContent = currentEditingSlug ? 'Update & Publish Article' : 'Save & Publish';
            }
          }
        });

        async function deleteArticle(slug) {
          try {
            const res = await fetch(`/api/articles?slug=${encodeURIComponent(slug)}`, {
              method: 'DELETE',
            });
            const data = await res.json();
            if (res.ok && data.success) {
              articles = articles.filter((a) => a.slug !== slug);
              const countEl = document.getElementById('articles-count-label');
              if (countEl) countEl.textContent = articles.length;
              renderArticlesTable();
              showToast(`Deleted ${slug} successfully.`);
            } else {
              showToast(data.error || 'Failed to delete article', true);
            }
          } catch (e) {
            articles = articles.filter((a) => a.slug !== slug);
            renderArticlesTable();
            showToast(`Removed ${slug} from list`);
          }
        }

        // ----------------------------------------------------
        // MEDIA LIBRARY ENGINE (CUSTOM UPLOADS + PRESETS)
        // ----------------------------------------------------
        function getCustomMedia() {
          try {
            return JSON.parse(localStorage.getItem('astro_custom_media') || '[]');
          } catch (e) {
            return [];
          }
        }

        function saveCustomMedia(items) {
          localStorage.setItem('astro_custom_media', JSON.stringify(items));
          renderMediaGallery();
        }

        function renderMediaGallery() {
          const grid = document.getElementById('media-gallery-grid');
          if (!grid) return;

          const customItems = getCustomMedia();
          const allMedia = [
            ...customItems.map((c) => ({ ...c, isCustom: true })),
            ...PRESET_IMAGES.map((p) => ({ ...p, isCustom: false })),
          ];

          const badge = document.getElementById('media-count-badge');
          if (badge) badge.textContent = allMedia.length;

          grid.innerHTML = allMedia
            .map(
              (img, idx) => `
            <div class="group rounded-xl border border-[#28231e]/10 dark:border-purple-500/20 bg-white/90 dark:bg-[#0f0b24]/90 overflow-hidden shadow-xs hover:border-[#855b25]/40 transition-all flex flex-col justify-between">
              <div class="aspect-video overflow-hidden bg-[#28231e]/5 relative">
                <img src="${img.url}" alt="${img.label}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                ${
                  img.isCustom
                    ? `<span class="absolute top-2 right-2 px-1.5 py-0.5 rounded text-[9px] font-bold bg-[#855b25] text-white uppercase">Custom</span>`
                    : ''
                }
              </div>
              <div class="p-3 text-xs space-y-2">
                <span class="font-medium text-[#110f0d] dark:text-[#ffffff] block truncate" title="${img.label}">${img.label}</span>
                <span class="text-[10px] font-mono text-[#5a534b] dark:text-[#a8a29a] block truncate" title="${img.url}">${img.url}</span>
                
                <div class="grid grid-cols-2 gap-1.5 pt-2 border-t border-[#28231e]/10 dark:border-purple-500/15">
                  <button
                    type="button"
                    class="btn-media-featured w-full py-1 rounded text-[10px] font-semibold bg-[#855b25]/10 text-[#855b25] dark:bg-purple-950/60 dark:text-[#e5c98f] hover:bg-[#855b25] hover:text-white dark:hover:bg-[#e5c98f] dark:hover:text-[#060410] transition-colors cursor-pointer text-center"
                    data-url="${img.url}"
                  >
                    Set Featured
                  </button>

                  <button
                    type="button"
                    class="btn-media-insert w-full py-1 rounded text-[10px] font-semibold bg-[#855b25] text-white dark:bg-[#e5c98f] dark:text-[#060410] hover:opacity-90 transition-opacity cursor-pointer text-center"
                    data-url="${img.url}"
                    data-label="${img.label}"
                  >
                    Insert In Text
                  </button>
                </div>

                <div class="flex items-center justify-between text-[10px] text-[#5a534b] dark:text-[#a8a29a] pt-1">
                  <button type="button" class="btn-copy-md hover:text-[#855b25] dark:hover:text-[#e5c98f] cursor-pointer" data-url="${img.url}" data-label="${img.label}">
                    Copy MD
                  </button>
                  <span>&bull;</span>
                  <button type="button" class="btn-copy-raw-url hover:text-[#855b25] dark:hover:text-[#e5c98f] cursor-pointer" data-url="${img.url}">
                    Copy Link
                  </button>
                  ${
                    img.isCustom
                      ? `<span>&bull;</span><button type="button" class="btn-delete-custom-media text-red-600/70 hover:text-red-600 cursor-pointer" data-id="${img.id}">Delete</button>`
                      : ''
                  }
                </div>
              </div>
            </div>
          `
            )
            .join('');

          // Set as Featured Image
          grid.querySelectorAll('.btn-media-featured').forEach((btn) => {
            btn.addEventListener('click', () => {
              const url = btn.getAttribute('data-url');
              if (inputFeaturedImage && url) {
                inputFeaturedImage.value = url;
                showToast(`Set featured image: ${url}`);
                setTab('editor');
              }
            });
          });

          // Insert directly into article content (Visual or Markdown)
          grid.querySelectorAll('.btn-media-insert').forEach((btn) => {
            btn.addEventListener('click', () => {
              const url = btn.getAttribute('data-url');
              const label = btn.getAttribute('data-label') || 'Image';
              if (!url) return;

              if (currentEditorMode === 'visual' && visualCanvas) {
                visualCanvas.focus();
                const imgHtml = `<p><img src="${url}" alt="${label}" class="my-4 rounded-xl shadow-md max-w-full" /></p><p><br></p>`;
                document.execCommand('insertHTML', false, imgHtml);
                syncFromVisualToMarkdown();
              } else if (inputContent) {
                const mdSyntax = `\n\n![${label}](${url})\n\n`;
                const start = inputContent.selectionStart || inputContent.value.length;
                const end = inputContent.selectionEnd || inputContent.value.length;
                inputContent.setRangeText(mdSyntax, start, end, 'end');
                inputContent.focus();
                syncFromMarkdownToVisual();
              }
              setTab('editor');
              showToast(`Inserted "${label}" into article!`);
            });
          });

          // Copy Markdown
          grid.querySelectorAll('.btn-copy-md').forEach((btn) => {
            btn.addEventListener('click', () => {
              const url = btn.getAttribute('data-url');
              const label = btn.getAttribute('data-label') || 'Image';
              const mdSyntax = `![${label}](${url})`;
              navigator.clipboard.writeText(mdSyntax);
              showToast(`Copied Markdown: ${mdSyntax}`);
            });
          });

          // Copy Raw Link
          grid.querySelectorAll('.btn-copy-raw-url').forEach((btn) => {
            btn.addEventListener('click', () => {
              const url = btn.getAttribute('data-url');
              if (url) {
                navigator.clipboard.writeText(url);
                showToast(`Copied image link: ${url}`);
              }
            });
          });

          // Delete custom media
          grid.querySelectorAll('.btn-delete-custom-media').forEach((btn) => {
            btn.addEventListener('click', () => {
              const id = btn.getAttribute('data-id');
              const updated = getCustomMedia().filter((m) => m.id !== id);
              saveCustomMedia(updated);
              showToast('Removed custom image from library.');
            });
          });
        }

        // Add Image via Direct URL
        document.getElementById('btn-add-media-url')?.addEventListener('click', () => {
          const urlInput = document.getElementById('media-url-input');
          const labelInput = document.getElementById('media-label-input');
          const url = (urlInput?.value || '').trim();
          const label = (labelInput?.value || '').trim() || 'Custom Image';

          if (!url) {
            alert('Please enter a valid image URL');
            return;
          }

          const customItems = getCustomMedia();
          customItems.unshift({
            id: `media-${Date.now()}`,
            url,
            label,
          });

          saveCustomMedia(customItems);
          if (urlInput) urlInput.value = '';
          if (labelInput) labelInput.value = '';
          showToast(`Added "${label}" to Media Library!`);
        });

        // Upload Image from Local Computer
        const fileInput = document.getElementById('media-file-input');
        document.getElementById('btn-trigger-upload')?.addEventListener('click', () => {
          fileInput?.click();
        });

        fileInput?.addEventListener('change', async (e) => {
          const file = e.target.files?.[0];
          if (!file) return;

          const label = file.name.replace(/\.[^/.]+$/, '');
          showToast(`Uploading "${label}" to storage...`);

          try {
            const formData = new FormData();
            formData.append('file', file);
            formData.append('label', label);

            const res = await fetch('/api/upload', {
              method: 'POST',
              body: formData,
            });

            if (res.ok) {
              const data = await res.json();
              if (data.success && data.url) {
                const customItems = getCustomMedia();
                customItems.unshift({
                  id: data.key || `upload-${Date.now()}`,
                  url: data.url,
                  label: data.label || label,
                });
                saveCustomMedia(customItems);
                showToast(`Saved "${label}" to Cloudflare R2 Media Library!`);
                fileInput.value = '';
                return;
              }
            }
          } catch (err) {
            console.warn('R2 upload failed, falling back to local storage:', err);
          }

          // Fallback to local Data URL if R2 endpoint is unavailable or local dev
          const reader = new FileReader();
          reader.onload = (loadEvent) => {
            const dataUrl = loadEvent.target?.result;
            if (typeof dataUrl === 'string') {
              const customItems = getCustomMedia();
              customItems.unshift({
                id: `upload-${Date.now()}`,
                url: dataUrl,
                label,
              });
              saveCustomMedia(customItems);
              showToast(`Saved "${label}" to local Media Library!`);
              fileInput.value = '';
            }
          };
          reader.readAsDataURL(file);
        });

        document.getElementById('btn-pick-media-header')?.addEventListener('click', () => {
          setTab('media');
        });

        // ----------------------------------------------------
        // USER & ACCESS MANAGEMENT
        // ----------------------------------------------------
        function renderUsersTable() {
          const tbody = document.getElementById('users-table-body');
          const countEl = document.getElementById('users-table-count');
          const badgeEl = document.getElementById('users-count-badge');
          if (!tbody) return;

          if (countEl) countEl.textContent = users.length;
          if (badgeEl) badgeEl.textContent = users.length;

          if (users.length === 0) {
            tbody.innerHTML = `
              <tr>
                <td colspan="4" class="py-8 text-center text-xs text-[#5a534b] dark:text-[#a8a29a]">
                  No publishing users found in D1.
                </td>
              </tr>
            `;
            return;
          }

          tbody.innerHTML = users
            .map((u) => {
              const isRoot = u.username === 'admin' || u.username === 'anisha';
              const roleBadgeClass =
                u.role === 'admin'
                  ? 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20'
                  : u.role === 'editor'
                  ? 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20'
                  : 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20';

