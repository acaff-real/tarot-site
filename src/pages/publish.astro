                <tr class="hover:bg-[#faf8f5]/60 dark:hover:bg-[#150f33]/40 transition-colors">
                  <td class="py-3.5 px-4 sm:px-6">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-full bg-[#855b25]/10 dark:bg-purple-900/40 text-[#855b25] dark:text-[#e5c98f] flex items-center justify-center font-bold text-xs uppercase">
                        ${u.username.charAt(0)}
                      </div>
                      <div>
                        <span class="font-medium text-[#110f0d] dark:text-[#ffffff] block text-xs">
                          @${u.username}
                        </span>
                        ${isRoot ? '<span class="text-[10px] text-[#855b25] dark:text-[#e5c98f] font-mono">Primary Root Admin</span>' : ''}
                      </div>
                    </div>
                  </td>
                  <td class="py-3.5 px-4">
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wider ${roleBadgeClass}">
                      ${u.role || 'author'}
                    </span>
                  </td>
                  <td class="py-3.5 px-4">
                    <span class="inline-flex items-center gap-1.5 text-[11px] text-emerald-600 dark:text-emerald-400">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      D1 Hash Stored
                    </span>
                  </td>
                  <td class="py-3.5 px-4 sm:px-6 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <button
                        type="button"
                        class="btn-edit-user text-[11px] font-semibold text-[#855b25] dark:text-[#e5c98f] hover:underline cursor-pointer"
                        data-username="${u.username}"
                        data-role="${u.role || 'author'}"
                      >
                        Update Pass
                      </button>
                      ${
                        !isRoot
                          ? `
                        <span class="text-[#5a534b]/40">|</span>
                        <button
                          type="button"
                          class="btn-delete-user text-[11px] font-semibold text-red-600/80 hover:text-red-600 cursor-pointer"
                          data-username="${u.username}"
                        >
                          Revoke
                        </button>
                      `
                          : ''
                      }
                    </div>
                  </td>
                </tr>
              `;
            })
            .join('');

          // Bind edit buttons
          tbody.querySelectorAll('.btn-edit-user').forEach((btn) => {
            btn.addEventListener('click', () => {
              const username = btn.getAttribute('data-username');
              const role = btn.getAttribute('data-role');
              const unameInput = document.getElementById('input-new-username');
              const roleSelect = document.getElementById('input-new-role');
              const passInput = document.getElementById('input-new-password');

              if (unameInput && username) unameInput.value = username;
              if (roleSelect && role) roleSelect.value = role;
              if (passInput) {
                passInput.focus();
                showToast(`Enter new password for @${username} above and click Save.`);
              }
            });
          });

          // Bind delete buttons
          tbody.querySelectorAll('.btn-delete-user').forEach((btn) => {
            btn.addEventListener('click', async () => {
              const username = btn.getAttribute('data-username');
              if (!username) return;

              if (confirm(`Revoke publishing permissions for user "@${username}"? They will no longer be able to log in.`)) {
                try {
                  const res = await fetch(`/api/users?username=${encodeURIComponent(username)}`, {
                    method: 'DELETE',
                  });
                  const data = await res.json();
                  if (res.ok && data.success) {
                    users = users.filter((u) => u.username !== username);
                    renderUsersTable();
                    showToast(data.message || `Revoked user @${username}`);
                  } else {
                    showToast(data.error || 'Failed to delete user', true);
                  }
                } catch (e) {
                  showToast('Network error deleting user', true);
                }
              }
            });
          });
        }

        // Manage User Form Handler
        const formManageUser = document.getElementById('form-manage-user');
        formManageUser?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const unameInput = document.getElementById('input-new-username');
          const passInput = document.getElementById('input-new-password');
          const roleSelect = document.getElementById('input-new-role');
          const saveBtn = document.getElementById('btn-save-user');

          const username = (unameInput?.value || '').trim();
          const password = (passInput?.value || '').trim();
          const role = roleSelect?.value || 'author';

          if (!username || !password) {
            showToast('Username and password are required', true);
            return;
          }

          try {
            if (saveBtn) saveBtn.setAttribute('disabled', 'true');
            const res = await fetch('/api/users', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ username, password, role }),
            });
            const data = await res.json();

            if (res.ok && data.success) {
              showToast(data.message || `User @${username} authorized successfully!`);
              if (passInput) passInput.value = '';
              if (unameInput) unameInput.value = '';

              const existingIdx = users.findIndex((u) => u.username === username);
              if (existingIdx >= 0) {
                users[existingIdx].role = role;
              } else {
                users.push({ id: Date.now(), username, role });
              }
              renderUsersTable();
            } else {
              showToast(data.error || 'Failed to save user', true);
            }
          } catch (err) {
            showToast('Network error authorizing user', true);
          } finally {
            if (saveBtn) saveBtn.removeAttribute('disabled');
          }
        });

        // Toggle password visibility
        document.getElementById('btn-toggle-password-visibility')?.addEventListener('click', () => {
          const passInput = document.getElementById('input-new-password');
          if (passInput) {
            passInput.type = passInput.type === 'password' ? 'text' : 'password';
          }
        });

        // Refresh users button
        document.getElementById('btn-refresh-users')?.addEventListener('click', async () => {
          try {
            showToast('Refreshing accounts from D1...');
            const res = await fetch('/api/users');
            const data = await res.json();
            if (res.ok && data.success && Array.isArray(data.users)) {
              users = data.users;
              renderUsersTable();
              showToast('Refreshed user accounts from D1');
            }
          } catch (e) {
            showToast('Failed to refresh users', true);
          }
        });

        setTab('list');
        renderArticlesTable();
        updateDraftsBadge();
        renderMediaGallery();
        renderUsersTable();
      </script>
    </div>
  )}

