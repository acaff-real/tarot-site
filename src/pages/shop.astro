---
import Layout from '../layouts/Layout.astro';
import GlassButton from '../components/GlassButton.astro';

const FUTURE_PRODUCTS = [
  {
    title: 'The Contemplative Journal',
    category: 'Print & Stationary',
    desc: 'Linen-bound archival journal featuring guided prompts for planetary transits, seasonal thresholds, and personal reflections.',
    badge: 'Coming Soon',
  },
  {
    title: 'Mindful Affirmation Deck',
    category: 'Archetypal Cards',
    desc: 'A 54-card contemplative deck centered on psychological sovereignty, planetary grounding, and daily intentionality.',
    badge: 'In Development',
  },
  {
    title: 'The Astrology with Anisha Tarot Deck',
    category: 'Original Tarot Edition',
    desc: 'A bespoke 78-card luxury tarot deck synthesizing classic archetypal symbolism with contemporary aesthetic restraint.',
    badge: 'In Design',
  },
];
---

<Layout
  title="Shop — Astrology with Anisha"
  description="Curated editions and artifacts for contemplation and timing. Journals, affirmation cards, and original tarot editions by Anisha Banerji."
  currentPath="/shop"
>
  <!-- Header -->
  <section class="pt-8 pb-10 sm:pt-12 sm:pb-14 md:pt-14 md:pb-16 lg:pt-16 lg:pb-20 bg-[#fcfbf9] dark:bg-[#090716] border-b border-[#28231e]/10 dark:border-purple-500/20">
    <div class="max-w-4xl xl:max-w-6xl mx-auto px-4 sm:px-6 md:px-8">
      <!-- Back to Home Link -->
      <div class="mb-4 sm:mb-6 text-left">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs uppercase tracking-wider text-[#5a534b] dark:text-[#a8a29a] hover:text-[#110f0d] dark:hover:text-[#ffffff] transition-colors font-medium select-none"
          aria-label="Back to homepage"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Home</span>
        </a>
      </div>

      <div class="text-center">
        <span class="text-xs uppercase tracking-[0.25em] text-[#855b25] dark:text-[#e5c98f] font-semibold block mb-3">
          Editions & Artifacts
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-[#110f0d] dark:text-[#ffffff] tracking-tight leading-tight font-medium">
          The Studio Shop
        </h1>
        <p class="mt-4 text-base sm:text-lg md:text-xl text-[#2c2722] dark:text-[#f0ebe1] font-normal max-w-2xl xl:max-w-3xl mx-auto leading-relaxed">
          Intentional physical companions designed to deepen your daily contemplation, self-inquiry, and astrological awareness.
        </p>
      </div>
    </div>
  </section>

  <!-- Curated Products Grid (Reference: chanishop.com) -->
  <section class="py-14 sm:py-18 md:py-20 lg:py-24 xl:py-28 bg-[#faf8f5] dark:bg-[#060410]">
    <div class="max-w-[1440px] 2xl:max-w-[1560px] mx-auto px-4 sm:px-6 md:px-8 lg:px-10 xl:px-12">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 gap-6 md:gap-6 lg:gap-8 mb-16 sm:mb-20">
        {
          FUTURE_PRODUCTS.map((prod) => (
            <div class="glass-card rounded-xl p-6 sm:p-7 md:p-8 border border-[#28231e]/15 dark:border-purple-500/25 bg-white/90 dark:bg-[#0f0b24]/90 flex flex-col justify-between shadow-xs">
              <div>
                <div class="aspect-[4/3] rounded-lg bg-[#f5efe6] dark:bg-[#120d2c] border border-[#28231e]/10 dark:border-purple-500/20 mb-6 flex items-center justify-center p-6 text-center">
                  <span class="font-serif text-3xl text-[#855b25] dark:text-[#e5c98f] italic">✦</span>
                </div>
                
                <div class="flex items-center justify-between mb-2">
                  <span class="text-[10px] uppercase tracking-[0.2em] text-[#855b25] dark:text-[#e5c98f] font-semibold">
                    {prod.category}
                  </span>
                  <span class="px-2.5 py-0.5 rounded-md text-[10px] uppercase tracking-wider font-semibold bg-[#28231e]/5 dark:bg-purple-950/50 text-[#38322c] dark:text-[#ded9d0]">
                    {prod.badge}
                  </span>
                </div>

                <h3 class="font-serif text-2xl text-[#110f0d] dark:text-[#ffffff] font-medium leading-snug mb-3">
                  {prod.title}
                </h3>
                
                <p class="text-sm text-[#38322c] dark:text-[#ded9d0] font-normal leading-relaxed">
                  {prod.desc}
                </p>
              </div>

              <div class="pt-6 border-t border-[#28231e]/10 dark:border-purple-500/20 mt-6">
                <a
                  href="#shop-notify"
                  class="glass-pill-btn text-xs font-semibold uppercase tracking-wider py-3 px-4 text-center w-full justify-center bg-white/90 dark:bg-purple-950/60 text-[#110f0d] dark:text-[#ffffff] hover:bg-[#110f0d] hover:text-white dark:hover:bg-[#e5c98f] dark:hover:text-[#0c091f] transition-all"
                >
                  Join Release Waitlist
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Release Notification Form -->
      <div id="shop-notify" class="max-w-2xl xl:max-w-3xl mx-auto rounded-xl p-8 sm:p-12 bg-white/90 dark:bg-[#0f0b24]/90 border border-[#28231e]/15 dark:border-purple-500/25 text-center shadow-md">
        <span class="text-xs uppercase tracking-[0.25em] text-[#855b25] dark:text-[#e5c98f] font-semibold block mb-2">
          First Access
        </span>
        <h3 class="font-serif text-3xl sm:text-4xl text-[#110f0d] dark:text-[#ffffff] mb-3 font-medium">
          Early Product Releases
        </h3>
        <p class="text-sm text-[#38322c] dark:text-[#ded9d0] font-normal mb-6 max-w-lg mx-auto leading-relaxed">
          Sign up to receive private notifications when our journals, affirmation decks, and tarot collections become available for pre-order.
        </p>

        <form
          class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
          onsubmit="event.preventDefault(); const email = this.querySelector('input').value; window.location.href = `mailto:anishabanerji@gmail.com?subject=${encodeURIComponent('Shop Product Waitlist')}&body=${encodeURIComponent('Please notify me for product releases: ' + email)}`; alert('Thank you for joining the product waitlist!');"
        >
          <input
            type="email"
            required
            placeholder="Enter your email address"
            class="flex-grow px-4 py-2.5 rounded-md glass-input text-sm text-[#110f0d] dark:text-[#ffffff]"
          />
          <GlassButton
            text="Notify Me"
            type="submit"
            size="compact"
          />
        </form>
      </div>

    </div>
  </section>
</Layout>
